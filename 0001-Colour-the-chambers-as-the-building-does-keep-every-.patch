+          <tr>
+            <td class="num">{e.number}</td>
+            <td><a href={`/as-at/${e.date}/`}>{formatDate(e.date)}</a></td>
+            <td class="num">{fmt(e.senate.outstanding)}</td>
+            <td class="num">{fmt(e.house.outstanding)}</td>
