---
import { liveRegisters } from "../lib/registers";
import { currentEdition, editionDiff, formatDate } from "../lib/data";

export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const year = new Date().getFullYear();

// Nav is generated from the register config, so adding the House or WA is a
// one-line change there rather than an edit here.
const nav = [
  { href: "/", label: "Home" },
  // House before Senate, as the site's author wants it. A pre-launch review
  // argued for the Senate first, on the grounds that it is the first claimant
  // and the larger register; that is a reason, not a decision, and the decision
  // is his. The home page is ordered to match — the two must never disagree.
  ...liveRegisters()
    .slice()
    // House first, as the author asked; the register slug is carried through so
    // each item can take its chamber's colour.
    .sort((a, b) => (a.slug === "house" ? -1 : b.slug === "house" ? 1 : 0))
    .map((r) => ({ href: `/${r.slug}/`, label: r.shortName, register: r.slug })),
  // Every other item in this bar names a thing the site holds. "Search" named
  // an action instead, and did not say what there was to search — a reader
  // scanning the bar had no way to know the recommendations were there at all.
  { href: "/recommendations/", label: "Recommendations" },
  { href: "/methods/", label: "Methods" },
  { href: "/about/", label: "About" },
];
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const SITE = "https://toohardbasket.org.au";
/*
 * The edition this build is publishing: the last dated record the weekly job
 * kept. Every page names it in the footer, with the address at which this
 * build's figures will stay reachable after next week's run has moved them.
 */
const edition = currentEdition();
const moved = editionDiff();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — The Too Hard Basket</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE).href} />
    {/* A link pasted into an editor's Slack or an email preview should say what
        it is. Without these it shows as a bare URL, which reads as a link
        someone is not sure about — and the way this register travels is one
        journalist sending it to another.

        The card is not decoration: it is the two registers' counts, side by
        side and never added, the longest wait, and the date the data is current
        to. It is redrawn by the weekly job from the same files the pages are
        built from, so it cannot say something the site does not. */}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"
          content="The Too Hard Basket: the number of committee reports awaiting a government response in each chamber, and the date the record is current to." />
    <meta property="og:site_name" content="The Too Hard Basket" />
    <meta property="og:title" content={`${title} — The Too Hard Basket`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      /* Rows a "show all" control has folded away; the attribute must win
         over the phone layout's display rules on table rows. */
      [hidden] { display: none !important; }
      .show-all { margin: 0.75rem 0 0; font-family: var(--sans); font-size: 0.875rem; }
      .show-all button {
        font: inherit; background: none; border: 1px solid var(--rule-strong); border-radius: 2px;
        padding: 0.4rem 0.8rem; color: inherit; cursor: pointer;
      }
      .show-all button:hover { border-color: currentColor; }
      .show-all button:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
      :root {
        color-scheme: light;
        --surface:        #fcfcfb;
        --surface-sunken: #f4f4f1;
        --ink:            #0b0b0b;
        --ink-secondary:  #4c4b48;
        /* 6.2:1 on the surface for the muted, 8.5:1 for the secondary. The
           first pair were 4.43 and 4.30, a fraction under WCAG AA for small
           text; the second, 5.0 and 7.7, passed on paper and still read as
           faint on a phone, where the small-caps labels are the smallest type
           on the site. Muted is for a label or a legend, never a paragraph. */
        --ink-muted:      #605f5a;
        --rule:           #dedcd5;
        --rule-strong:    #b9b6ad;
        --series-1:       #2168c2;
        /*
         * The chambers' own colours — the House's eucalyptus and the Senate's
         * ochre, as the building has them, not web red and green. They mark
         * which register a thing belongs to: a rule above a tile, a label, the
         * active item in the nav, the dot beside a register's name, the bar
         * under a wait. They are never the colour of a number: an ochre 82
         * beside a green 38 would say the Senate is failing and the House is
         * fine, which is the one comparison this site says must not be made.
         * Both clear 4.5:1 on the surface, and nothing relies on telling them
         * apart — every use sits beside the chamber's name.
         */
        --house:          #356F4C;
        --senate:         #A63D2F;
        --measure: 34rem;
        /*
         * Self-hosted, and the fallback is named rather than left to chance.
         * On the system stack this site was Segoe on Windows, San Francisco on
         * a Mac and Roboto on Android: a journalist and a senator's staffer saw
         * measurably different pages, and no line broke where it was set to
         * break. Two families, one job each — the prose is a record and is set
         * in a serif; everything that is a number, a label or a control is a
         * datum and is set in the sans.
         */
        --serif: "Source Serif 4", Charter, "Bitstream Charter", Cambria,
                 Georgia, "Times New Roman", serif;
        --sans: "Source Sans 3", ui-sans-serif, system-ui, -apple-system,
                "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --surface:        #1a1a19;
          --surface-sunken: #232322;
          --ink:            #ffffff;
          --ink-secondary:  #d3d2c8;
          --ink-muted:      #aeaca1;
          --rule:           #34342f;
          --rule-strong:    #4c4c45;
          --series-1:       #3987e5;
          --house:          #7FB58F;
          --senate:         #E08A79;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --surface:        #1a1a19;
        --surface-sunken: #232322;
        --ink:            #ffffff;
        --ink-secondary:  #d3d2c8;
        --ink-muted:      #aeaca1;
        --rule:           #34342f;
        --rule-strong:    #4c4c45;
        --series-1:       #3987e5;
        --house:          #7FB58F;
        --senate:         #E08A79;
      }

      /*
       * font-display: swap — the register must be readable before the fonts
       * arrive, and a fallback is named for each so the reflow is small. The
       * files are latin subsets, 128KB for all five, served from this origin:
       * no third-party request, so nobody's visit to this site is logged
       * anywhere else.
       */
      @font-face {
        font-family: "Source Serif 4"; font-style: normal; font-weight: 400;
        font-display: swap;
        src: url("/fonts/source-serif-4-latin-400-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Serif 4"; font-style: italic; font-weight: 400;
        font-display: swap;
        src: url("/fonts/source-serif-4-latin-400-italic.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Serif 4"; font-style: normal; font-weight: 600;
        font-display: swap;
        src: url("/fonts/source-serif-4-latin-600-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Sans 3"; font-style: normal; font-weight: 400;
        font-display: swap;
        src: url("/fonts/source-sans-3-latin-400-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Sans 3"; font-style: normal; font-weight: 500;
        font-display: swap;
        src: url("/fonts/source-sans-3-latin-500-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Sans 3"; font-style: normal; font-weight: 600;
        font-display: swap;
        src: url("/fonts/source-sans-3-latin-600-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Source Sans 3"; font-style: normal; font-weight: 700;
        font-display: swap;
        src: url("/fonts/source-sans-3-latin-700-normal.woff2") format("woff2");
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      /* A phone is read closer and in worse light than a laptop. One step up
         at the root and everything set in rem — the small type included —
         comes up with it, in proportion. */
      @media (max-width: 30rem) { html { font-size: 106.25%; } }
      body {
        margin: 0;
        background: var(--surface);
        color: var(--ink);
        font-family: var(--serif);
        font-size: 1.0625rem;
        line-height: 1.62;
      }

      /*
       * The division of labour, in one place. Prose inherits the serif from
       * body. Anything a reader scans rather than reads — a table, a figure, a
       * label, a control — takes the sans, where the numerals are the right
       * width and a small size stays legible.
       */
      table, .eyebrow, .stats, .stats-note, .figure, svg text,
      header.site nav, footer.site, .filters, .search, .chip, .status, .more,
      button, input, select, .num, .human, .tag, .byline, .basis, .who,
      .from-tracker, code, kbd {
        font-family: var(--sans);
      }
      /* A chart's caption is prose about the chart and stays in the serif with
         the rest of the argument; only its labels, figures and table view take
         the sans. Setting the whole figure in sans put four sentences of
         explanation in the type meant for axis ticks. */
      figure.chart figcaption { font-family: var(--serif); }
      table { font-size: 0.9375rem; }
      a { color: inherit; text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
      a:hover { text-decoration-color: var(--series-1); }

      .wrap { width: min(72rem, 100% - 2.5rem); margin-inline: auto; }
      .measure { max-width: var(--measure); }

      /*
       * One left edge on every page.
       *
       * ".wrap" centres a 72rem column and everything inside it starts at that
       * column's left edge. ".wrap measure" narrowed the box itself to 34rem
       * and kept the centring, so those blocks — the footer, "How to read a
       * result", several notes — sat on a different left edge from the title
       * above them. It reads as accidental, because it was. The box keeps the
       * standard width and the reading measure is applied to its children, so
       * the text is the same width as before and starts where everything else
       * on the page starts.
       */
      .wrap.measure { max-width: none; }
      .wrap.measure > * { max-width: var(--measure); }

      /* The label style that makes it read as a register rather than an essay. */
      .eyebrow {
        font-size: 0.6875rem;
        /* Eleven pixels of capitals is a label on a laptop and a squint on a
           phone, where the line also wraps three deep. */
        @media (max-width: 30rem) { font-size: 0.75rem; }
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin: 0 0 0.5rem;
      }

      header.site { border-bottom: 1px solid var(--rule); }
      header.site .bar {
        display: flex; flex-wrap: wrap; gap: 0.75rem 2rem;
        align-items: baseline; justify-content: space-between;
        padding-block: 1.1rem;
      }
      header.site .mark { font-weight: 650; letter-spacing: -0.015em; text-decoration: none; }
      header.site .mark span { color: var(--ink-muted); font-weight: 400; }
      /* Five items no longer fit on a narrow phone, and a nav that overflows
         takes the whole page sideways with it. */
      header.site nav { display: flex; flex-wrap: wrap; gap: 1.4rem;
                        font-size: 0.875rem; min-width: 0; }
      @media (max-width: 30rem) {
        header.site nav { gap: 0.9rem; font-size: 0.875rem; }
        /* On a phone the masthead wraps and leaves its middle dot hanging at
           the end of the first line; the domain is in the address bar anyway. */
        header.site .mark span { display: none; }
      }
      header.site nav a { color: var(--ink-secondary); text-decoration: none; padding-block: 0.15rem; }
      header.site nav a[aria-current="page"] {
        color: var(--ink); box-shadow: inset 0 -2px 0 var(--series-1);
      }
      /* On a register's own page the underline is that chamber's colour. */
      header.site nav a[data-register="senate"][aria-current="page"] { box-shadow: inset 0 -2px 0 var(--senate); }
      header.site nav a[data-register="house"][aria-current="page"] { box-shadow: inset 0 -2px 0 var(--house); }

      /*
       * The dot that names a register wherever a row could belong to either.
       * Always beside the word, never instead of it.
       */
      .reg-dot {
        display: inline-block; width: 0.5em; height: 0.5em; border-radius: 50%;
        margin-right: 0.4em; vertical-align: 0.05em; background: var(--series-1);
      }
      .reg-dot[data-register="senate"] { background: var(--senate); }
      .reg-dot[data-register="house"] { background: var(--house); }
      .eyebrow .reg-label[data-register="senate"] { color: var(--senate); font-weight: 600; }
      .eyebrow .reg-label[data-register="house"] { color: var(--house); font-weight: 600; }

      main { padding-block: 3rem 4rem; }
      h1 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); line-height: 1.2;
           letter-spacing: -0.02em; margin: 0 0 0.75rem; }
      h2 { font-size: 1.125rem; letter-spacing: -0.005em; margin: 0 0 0.6rem; }
      p { margin: 0 0 1rem; }
      .lede { font-size: 1.0625rem; color: var(--ink-secondary); }

      footer.site {
        border-top: 1px solid var(--rule);
        margin-top: 4rem; padding-block: 1.75rem 3rem;
        font-size: 0.875rem; color: var(--ink-secondary);
      }
      footer.site p { margin: 0 0 0.5rem; }

      /* The figure columns already aligned; this reaches the duration line under
         each one, which did not. */
      table.register { width: 100%; border-collapse: collapse; font-size: 0.875rem;
                       font-variant-numeric: tabular-nums; }
      table.register th, table.register td {
        text-align: left; padding: 0.55rem 0.75rem 0.55rem 0;
        border-bottom: 1px solid var(--rule); vertical-align: baseline;
      }
      table.register th {
        font-size: 0.6875rem; letter-spacing: 0.09em; text-transform: uppercase;
        color: var(--ink-muted); font-weight: 500; border-bottom-color: var(--rule-strong);
      }
      /* Columns of figures align; standalone display numbers never do. */
      table.register td.num, table.register th.num { text-align: right;
        font-variant-numeric: tabular-nums; }
      table.register td:last-child, table.register th:last-child { padding-right: 0; }

      /*
       * Fixed widths for everything except the report title, which takes the
       * slack. Without this the browser sizes every column to its longest
       * entry, so one 190-character report title squeezes the dates into two
       * lines and the table's shape changes with the data in it.
       */
      /*
       * Column widths for the two report registers, and only those: the
       * summary tables on the same pages have different columns and are left
       * to the browser.
       *
       * They are set on the header row because that is the only row a fixed
       * layout reads. Set on the body cells — where the classes are — they did
       * nothing at all except reflow the table, which is how the first attempt
       * at this managed to make the titles worse while appearing to work.
       *
       * The report title is the column a reader actually reads, so it is the
       * one with no width: it takes whatever the other four do not need. The
       * committee wraps to two lines happily; the title should not have to.
       */
      table.register.stacks { table-layout: auto; }
      @media (min-width: 60rem) {
        table.register.stacks { table-layout: fixed; }
        table.register.stacks thead th:nth-child(1) { width: 9rem; }   /* waiting */
        table.register.stacks thead th:nth-child(3) { width: 11.5rem; } /* committee */
        table.register.stacks thead th:nth-child(4) { width: 6.5rem; } /* tabled */
        table.register.stacks thead th:nth-child(5) { width: 9rem; }   /* status */
        table.register.stacks td { overflow-wrap: anywhere; }
      }

      /*
       * The wait, drawn as well as counted. The column is already sorted by it,
       * so the bar makes the sort visible: a reader sees the shape of the
       * backlog before reading a single number, and the top of the table stops
       * being a list of four-digit figures that all look alike. One colour, the
       * same blue as everything else, and it is decoration over a number that
       * is still printed — nothing here depends on reading the bar.
       */
      table.register td.c-wait { position: relative; }
      table.register td.c-wait .bar {
        display: block; height: 4px; margin: 0.3rem 0 0 auto;
        background: var(--series-1); opacity: 0.5; border-radius: 2px;
        min-width: 3px;
      }
      /* On a register's own page the bar is that chamber's colour, and a little
         stronger, because there it is the only colour on the table. */
      table.register[data-register="senate"] td.c-wait .bar { background: var(--senate); opacity: 0.75; }
      table.register[data-register="house"] td.c-wait .bar { background: var(--house); opacity: 0.75; }
      /* The column is right-aligned, so the bars end where the figures end and
         grow leftwards from that edge. Growing from the left would put the
         short bars nowhere near the numbers they belong to. */
      @media (prefers-reduced-motion: no-preference) {
        table.register td.c-wait .bar { transition: width 0.2s ease; }
      }

      /*
       * The registers on a phone. Six columns in 390 pixels pushed the table to
       * 640 and took the whole page sideways with it: the title wrapped to five
       * lines, the committee was cut off at the edge, and the status — which is
       * the point of the row — was off-screen entirely. Journalists read pitches
       * on phones.
       *
       * Below 46rem each row becomes a block: the report first, then how long it
       * has waited, then a line of labelled detail. Same HTML, same order in the
       * source, reordered with flex so the reading order is right.
       */
      @media (max-width: 46rem) {
        table.register.stacks,
        table.register.stacks tbody,
        table.register.stacks tr,
        table.register.stacks td { display: block; width: auto; }
        table.register.stacks thead { display: none; }
        table.register.stacks tr {
          display: flex; flex-direction: column;
          padding: 0.9rem 0 1rem; border-bottom: 1px solid var(--rule);
        }
        table.register.stacks td {
          border: 0; padding: 0; text-align: left; white-space: normal;
        }
        table.register.stacks td.c-title {
          order: 1; font-weight: 600; line-height: 1.4; margin-bottom: 0.3rem;
        }
        table.register.stacks td.c-wait {
          order: 2; font-variant-numeric: tabular-nums;
        }
        table.register.stacks td.c-wait .human { display: inline; }
        table.register.stacks td.c-wait .human::before { content: " · "; }
        /* The bar grows leftwards from the figures in the table; in a card it
           was floating at the right edge under nothing. Under the figure, from
           the left, it reads as what it is. */
        table.register.stacks td.c-wait .bar { margin-left: 0; margin-top: 0.4rem; }
        table.register.stacks td.c-meta {
          order: 3; font-size: 0.875rem; color: var(--ink-secondary);
          margin-top: 0.15rem;
        }
        table.register.stacks td.c-meta[data-label]::before {
          content: attr(data-label) " ";
          font-size: 0.6875rem; letter-spacing: 0.09em; text-transform: uppercase;
          color: var(--ink-muted);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }

      /*
       * Print. Someone will take a register into a meeting. The navigation, the
       * footer and the search controls are of no use on paper; the table is,
       * and its rows must not break across pages.
       */
      @media print {
        :root { color-scheme: light; }
        header.site nav, footer.site, .controls, details { display: none !important; }
        header.site { border-bottom: 1px solid #999; }
        body { background: #fff; color: #000; font-size: 10pt; }
        a { text-decoration: none; }
        a[href^="http"]::after { content: " (" attr(href) ")"; font-size: 8pt; word-break: break-all; }
        table { page-break-inside: auto; }
        tr { page-break-inside: avoid; }
        thead { display: table-header-group; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="mark" href="/">The Too Hard Basket <span>· toohardbasket.org.au</span></a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} data-register={n.register} aria-current={here === n.href.replace(/\/$/, "") || (n.href === "/" && here === "/") ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site">
      <div class="wrap measure">
        <p>
          The Too Hard Basket is a project of the Australian Public Interest Alliance,
          an Australian non-profit. It is independent and not affiliated with any
          political party or parliamentarian.
        </p>
        <p>
          Every figure is drawn from the Parliament’s own records (the presiding officers’
          schedules, the Senate’s register of responses and the Tabled Documents database),
          and every row names the document it came from and links to it. Where the report
          itself is on the Parliament’s website, the title links to it too. Found something
          wrong?{" "}
          <a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a>,
          and see the <a href="/corrections/">corrections log</a>.
        </p>
        {edition && (
          <p class="edition">
            Edition {edition.number}, as at {formatDate(edition.date)}, responses checked to
            {" "}{formatDate(edition.responses_checked_to)}.
            {moved && (
              <>
                {" "}Since the edition of {formatDate(moved.since)}: {moved.senate.left} left the Senate
                register and {moved.senate.joined} joined it; {moved.house.left} left the House register and
                {" "}{moved.house.joined} joined it.
              </>
            )}
            {" "}Every edition is kept unchanged at its own address. Cite this one as
            {" "}<a href={`/as-at/${edition.date}/`}>toohardbasket.org.au/as-at/{edition.date}/</a>.
          </p>
        )}
        <p>
          Data licensed CC BY 4.0 · code MIT ·{" "}
          <a href="https://github.com/toohardbasket-lab/toohardbasket">source and dataset on GitHub</a> ·
          © {year}
        </p>
      </div>
    </footer>
    <script>
      // Every day count on the page is arithmetic — the day a report was
      // tabled, and today in Canberra — and the register is rebuilt weekly, so
      // between builds the numbers printed into the page fall behind the clock
      // on the home page, which counts live. A reader saw 4,301 beside 4,299
      // for the same report and called it an anomaly, and it was. So every
      // element that carries a tabling date is recounted from today when the
      // page opens, with the register's own arithmetic; without a script the
      // page shows the figures as at the date in its eyebrow, all agreeing.
      // The dated editions under /as-at/ carry no such marks and never move.
      (() => {
        const els = document.querySelectorAll("[data-live-days], [data-live-human]");
        if (!els.length) return;
        const parts = new Intl.DateTimeFormat("en-AU", {
          timeZone: "Australia/Canberra", year: "numeric", month: "numeric", day: "numeric",
        }).formatToParts(new Date());
        const p: Record<string, number> = {};
        for (const part of parts) if (part.type !== "literal") p[part.type] = Number(part.value);
        const today = Date.UTC(p.year, p.month - 1, p.day);
        const days = (iso: string) => {
          const [y, m, d] = iso.split("-").map(Number);
          return Math.round((today - Date.UTC(y, m - 1, d)) / 86_400_000);
        };
        const human = (n: number) => {
          const years = Math.floor(n / 365.25);
          const months = Math.floor((n - years * 365.25) / 30.44);
          if (years === 0) return `${months} month${months === 1 ? "" : "s"}`;
          const y = `${years} year${years === 1 ? "" : "s"}`;
          return months === 0 ? y : `${y}, ${months} month${months === 1 ? "" : "s"}`;
        };
        for (const el of els as NodeListOf<HTMLElement>) {
          if (el.dataset.liveDays) {
            const n = days(el.dataset.liveDays);
            if (n >= 0) el.textContent = `${n.toLocaleString("en-AU")} days`;
          } else if (el.dataset.liveHuman) {
            const n = days(el.dataset.liveHuman);
            if (n >= 0) el.textContent = human(n);
          }
        }
      })();
    </script>
  </body>
</html>
