---
/**
 * The row of headline figures at the top of a register or the home page.
 *
 * One component rather than three copies of the same CSS, because the register
 * spec requires both registers to look and read the same, and three copies
 * drift. Both registers pass the same six figures in the same order; only the
 * deadline length differs, because the chambers ask for different things.
 *
 * Each tile is a flex column with the number pushed to the bottom, so a label
 * that wraps onto two lines does not shove its number out of line with the
 * others. Everything is centred and evenly padded — left-aligned numbers sat
 * hard against the divider and read as though they belonged to the tile before.
 *
 * The dividers are borders on the tiles, not a one-pixel grid gap over a ruled
 * background. Seven figures do not divide evenly into a responsive row, and
 * with the gap trick the empty cell at the end of the last row filled with the
 * rule colour: a grey slab half the width of the page, which read as a broken
 * layout rather than as a table with nothing more to say.
 */
interface Stat {
  label: string;
  value: string;
}
interface Props {
  stats: Stat[];
  /** What a figure in the row is measured over, where that is not obvious. */
  note?: string;
}
const { stats, note } = Astro.props;
---

<dl class="stats" style={`--cols:${stats.length}`}>
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd class="num">{s.value}</dd>
    </div>
  ))}
</dl>
{note && <p class="stats-note">{note}</p>}

<style>
  /*
   * The column count is the number of figures, not whatever fits: the row is a
   * set of six or seven readings of one register and it should be read across
   * in one line wherever there is room. Narrower screens step it down to four
   * and then three, and each step names which tiles start a row so the borders
   * fall on the right edges — auto-fit cannot say where a row begins.
   */
  .stats {
    display: grid;
    margin: 2rem 0 0;
    grid-template-columns: repeat(var(--cols, 6), 1fr);
    background: var(--surface);
    border-block: 1px solid var(--rule);
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding: 1rem 0.85rem 1.1rem;
    text-align: center;
    border-left: 1px solid var(--rule);
  }
  .stats > div:first-child { border-left: 0; }
  .stats dt {
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.35;
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }
  .stats dd {
    margin: auto 0 0;          /* bottom-aligned, so numbers line up across tiles */
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  @media (min-width: 30.01rem) and (max-width: 56rem) {
    .stats { grid-template-columns: repeat(4, 1fr); }
    .stats > div:nth-child(4n + 1) { border-left: 0; }
    .stats > div:nth-child(n + 5) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 30rem) {
    .stats { grid-template-columns: repeat(3, 1fr); }
    .stats > div { padding: 0.85rem 0.5rem 0.9rem; }
    .stats > div:nth-child(3n + 1) { border-left: 0; }
    .stats > div:nth-child(n + 4) { border-top: 1px solid var(--rule); }
    .stats dd { font-size: 1.3rem; }
  }
</style>
