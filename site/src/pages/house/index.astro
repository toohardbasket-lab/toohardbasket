---
import Base from "../../layouts/Base.astro";
import RegisterControls from "../../components/RegisterControls.astro";
import StatTiles from "../../components/StatTiles.astro";
import AnsweredSinceList from "../../components/AnsweredSince.astro";
import { ledger, scheduleMeta, answeredSince, humanDuration, fmt, formatDate, formatDateShort } from "../../lib/data";
import { registerBySlug } from "../../lib/registers";

/**
 * The House register. Deliberately the same page as /senate/ — same order, same
 * columns, same words — because a reader moving between them should have to
 * learn nothing new (claude/thb-register-spec.md §5).
 *
 * Two things are genuinely different and are stated on the page rather than
 * smoothed over: there is no compliance history for the House, and the
 * Speaker's schedule no longer records "the Government's response is being
 * considered", so the count the Senate page leads with cannot be given here.
 */
const reg = registerBySlug("house")!;
const rows = ledger("house");
const sched = scheduleMeta("house");
const removedSince = answeredSince("house");

/**
 * The Liaison Committee's June 2023 clearing (footnote 3 of the schedule) took
 * every House and joint report presented before 2 July 2019 off this list. The
 * President took nothing off his, so the joint reports from that period are
 * still on the Senate register — which is the measure of what was cleared.
 */
const CLEARED_BEFORE = "2019-07-02";
const keptBySenate = ledger("senate")
  .filter((r) => r.joint && r.owedSince < CLEARED_BEFORE)
  .sort((a, b) => a.owedSince.localeCompare(b.owedSince));

const overdue = rows.filter((r) => r.overdue);
const notYetDue = rows.filter((r) => !r.overdue);
const overOne = rows.filter((r) => r.daysOutstanding > 365);
const overFive = rows.filter((r) => r.daysOutstanding > 1826);
const partial = rows.filter((r) => r.partial);

const considered = rows.filter((r) => r.beingConsidered);

/** The same six figures, in the same order, as the Senate register. */
const stats = [
  { label: "Awaiting a response", value: fmt(rows.length) },
  { label: "Told it is being considered", value: fmt(considered.length) },
  { label: "Past the six-month deadline", value: fmt(overdue.length) },
  { label: "Still within time", value: fmt(notYetDue.length) },
  { label: "Waiting over a year", value: fmt(overOne.length) },
  { label: "Waiting over five years", value: fmt(overFive.length) },
  { label: "Met the deadline", value: `${((sched.onTimeRate ?? 0) * 100).toFixed(0)}%` },
];
const statsNote =
  `Met the deadline is the Speaker's own count, from the summary table on the fourth page of ` +
  `his schedule — ${fmt(sched.answeredOnTime ?? 0)} of ${fmt(sched.answeredWithVerdict ?? 0)} ` +
  `responses arrived within six months. Those are the responses received since his previous ` +
  `schedule, not a long-run record: unlike the Senate, the House publishes no register of ` +
  `responses going back to 2000, so this covers months where the Senate's equivalent covers ` +
  `decades. The two are not comparable and should not be quoted against each other.` +
  ((sched.onTimeGap ?? 0) > 0
    ? ` Counting the rows of his own list instead gives ${fmt(sched.rowsMarkedOnTime ?? 0)}; ` +
      `the ${fmt(sched.onTimeGap ?? 0)} in the gap are Public Accounts and Audit reports, ` +
      `answered by executive minute rather than by a government response. The smaller figure ` +
      `is published because it is his own total.`
    : "");

/**
 * The Speaker's verdict comes first where he has one. The government records
 * "being considered" against every report it has not answered — including the
 * nine the Speaker marks as partly answered — so showing that as the status of
 * all 38 both said less than the record does and contradicted the count of
 * partial responses in the row above.
 */
const statusOf = (r: (typeof rows)[number]): string =>
  r.partial ? "Answered in part"
  : r.beingConsidered ? "Being considered"
  : r.overdue ? "Nothing received"
  : "Not yet due";

const byCommittee = [...rows.reduce((m, r) => {
  const cur = m.get(r.body) ?? { body: r.body, count: 0, longest: 0 };
  cur.count += 1;
  cur.longest = Math.max(cur.longest, r.daysOutstanding);
  return m.set(r.body, cur);
}, new Map<string, { body: string; count: number; longest: number }>()).values()]
  .sort((a, b) => b.count - a.count || b.longest - a.longest);
---

<Base
  title="The House register"
  description={`Every ${reg.name.toLowerCase()} still awaiting a government response, how long each has waited, and where the record comes from.`}
>
  <section class="wrap intro">
    <p class="eyebrow">
      Register · {reg.claimant} · the Speaker’s schedule as at {formatDate(sched.asAt)}
    </p>
    <h1>The House register</h1>
    <p class="lede measure">
      Every House of Representatives and joint committee report the Speaker records as
      still waiting for a government response. The House has asked for {reg.rule} since
      {" "}{reg.ruleSince}. A report leaves this register when a response is tabled —
      whatever that response says.
    </p>

    <StatTiles stats={stats} note={statsNote} />
  </section>

  <section class="wrap">
    <h2 id="source">Where this comes from, and what it leaves out</h2>
    <p class="note measure">
      This register publishes what the presiding officer records, and nothing else. At
      roughly six-monthly intervals the Speaker presents to the House a schedule of the
      status of government responses to committee reports. The most recent is
      {" "}<a href={sched.url}>the schedule as at {formatDate(sched.asAt)}</a>, presented on
      {" "}{formatDate(sched.tabled)}. It lists {fmt(sched.listed)} reports and records a
      response received for {fmt(sched.answeredAtSchedule)} of them. The rest are here.
    </p>
    <p class="note measure">
      Since that date {fmt(sched.answeredSince)} more responses have been tabled, and those
      reports have been removed — a report the government has answered must not be
      published here as waiting. That is why this register shows {fmt(rows.length)} where the
      Speaker's schedule lists {fmt(sched.listed - sched.answeredAtSchedule)} still waiting.
    </p>
    <AnsweredSinceList rows={removedSince} officer="the Speaker" />
    {sched.officersDisagree > 0 && (
      <p class="note measure">
        <strong>The two officers do not always agree.</strong> The Speaker records
        {" "}{sched.officersDisagree === 1 ? "one report" : `${fmt(sched.officersDisagree)} reports`}
        {" "}as fully responded to that the President still lists as awaiting a response in
        part — Public Accounts and Audit reports
        {" "}{sched.officersDisagreeReports.join(", ")}, answered by executive minute one
        recommendation at a time. Neither record is edited here. The Senate register follows
        the President and the House register follows the Speaker, which is why the same
        report can be waiting on one page and answered on the other.
      </p>
    )}
    <p class="note measure">
      <strong>Most of what is here is not the House's own.</strong> A joint committee
      reports to both houses, so its report is listed by both presiding officers:
      {" "}{fmt(sched.jointCommittee)} of the {fmt(rows.length)} reports below are joint
      committee reports and only {fmt(sched.ownChamber)} are House committee reports.
      {" "}{fmt(sched.onBothRegisters)} are on {" "}<a href="/senate/">the Senate
      register</a> as well. That is why the two counts are never added: it would count the
      same report twice.
      {sched.deadlineDiffers > 0 && (
        <>
          {" "}It is also why the same report can be past the deadline on one register and
          within time on the other — the House counts six months from House presentation,
          the Senate three from Senate tabling, and
          {" "}{sched.deadlineDiffers === 1 ? "one report is" : `${fmt(sched.deadlineDiffers)} reports are`}
          {" "}in that position today.
        </>
      )}
    </p>
    <p class="note measure">
      Whether a report is past its deadline is the Speaker’s judgement, not ours: the
      resolution of {reg.ruleSince} gives six months but excludes any period when the House
      was dissolved, so the interval cannot simply be counted off a calendar.
    </p>
    <p class="note measure">
      Alongside it, the government publishes <a href={sched.beingConsideredSource}>its own
      status report</a>, presented on {formatDate(sched.beingConsideredTabled ?? "")} and
      covering the same date. That is where the words “the Government’s response is being
      considered” are actually written; the President of the Senate abbreviates the same
      sentence to an asterisk in his report. It is read here for one purpose — to say what
      the government has said about a report — and it can never add a report to this
      register or remove one from it. Which reports are outstanding is the Speaker’s to
      say. All {fmt(sched.governmentReportMatched ?? rows.length)} of the reports the
      Speaker listed as waiting at 30 June were found in it, and against every one of them
      the government records nothing more than that its response is being considered.
    </p>
    {sched.governmentStatuses && (
      <p class="note measure">
        <strong>How much that is worth saying.</strong> The government’s report has three
        things it can say about a report, and only three: that a response was tabled on a
        date ({fmt(sched.governmentStatuses.answered)} of the
        {" "}{fmt(sched.governmentReportListed ?? 0)} it lists), that a full response has
        been provided ({fmt(sched.governmentStatuses.full)}), or that the response is being
        considered ({fmt(sched.governmentStatuses.considered)}). A report it has not
        answered can only fall in the third. So “being considered” here is close to a
        restatement of “outstanding”, and the number worth reading is not how many, but how
        long: {fmt(overOne.length)} of these reports have been under consideration for more
        than a year and {fmt(overFive.length)} for more than five. On
        {" "}<a href="/senate/">the Senate register</a> the President distinguishes four
        states, so the same phrase carries more there.
      </p>
    )}
    <p class="note measure">
      It also disagrees with the Speaker. He records a partial response for
      {" "}{fmt(partial.length)} of the reports below — the Joint Committee of Public
      Accounts and Audit is answered by executive minute, one recommendation at a time — and
      the government’s report calls those “being considered” too. The status column here
      follows the Speaker, because his is the record this register publishes.
    </p>
    {(sched.outOfPeriod ?? 0) > 0 && (
      <p class="note measure">
        The schedule counts itself, by Parliament, on its fourth page, and that tally says
        {" "}{fmt(sched.scheduleSaysOutstanding ?? rows.length)} rather than the
        {" "}{fmt(rows.length)} published here. {fmt(sched.answeredSince)} of the difference
        is the responses tabled since, listed above.
        {" "}{sched.outOfPeriod === 1 ? "The last is one report" : `The rest are ${fmt(sched.outOfPeriod ?? 0)} reports`}
        {" "}for which the schedule’s own entry records a response received before this
        reporting period, and for which the government’s report records the same response.
        Two records say the report was answered and one aggregate says it was not, so it is
        not published here as waiting. We would rather be one short than name a report as
        unanswered when it was answered.
      </p>
    )}
    <p class="note measure">
      <strong>What it does not have.</strong> Reports tabled after
      {" "}{formatDate(sched.coversTo)}, which the Speaker has not yet reported on — and
      because the schedule is presented about twice a year, that gap can be months wide.
      No compliance history: unlike the Senate, the House has no published register of
      responses going back to 2000. The Speaker gives his own on-time verdict on the
      responses each schedule records, which is what the figure above reports, but it
      covers one reporting period rather than a quarter of a century. And no submission
      counts yet — the figures on how many people and organisations wrote to these
      inquiries have to be collected inquiry by inquiry, and that has not been done.
    </p>
    <p class="note measure">
      <strong>What the schedule itself leaves out</strong>, on its own second page:
      advisory reports on bills, unless their recommendations go wider than the bill;
      reports on treaties, unless their recommendations go wider than ratification; and
      reports of the Privileges and Members’ Interests and Publications committees.
    </p>
    <p class="note measure">
      <strong>And one deliberate clearing.</strong> The Speaker’s footnote 3 records that
      the Liaison Committee of Chairs and Deputy Chairs agreed in June 2023 to recommend
      “removal of all outstanding government responses for House or Joint committee
      reports presented prior to the commencement of the 46th Parliament (2 July 2019),
      unless the relevant committee’s successor resolved to retain those reports”. So this
      register reaches back only as far as that decision allows. It is not that the House
      has no older unanswered reports; it is that they were taken off the list.
      {keptBySenate.length > 0 && (
        <>
          {" "}{fmt(keptBySenate.length)} joint committee reports from before that date are
          still on {" "}<a href="/senate/">the Senate register</a>, where the President kept
          them — the oldest tabled in {keptBySenate[0].owedSince.slice(0, 4)}.
        </>
      )}
    </p>
  </section>

  <section class="wrap">
    <h2 id="outstanding">Outstanding reports</h2>
    <p class="note measure">
      Ordered by how long each has waited. <em>Answered in part</em> is the Speaker’s
      “partial response received”: the Joint Committee of Public Accounts and Audit is
      answered by executive minute, one recommendation at a time, and a report is not
      treated as finished until every recommendation has been answered.
      {" "}{partial.length > 0 && `${fmt(partial.length)} reports are in that state.`}
      {" "}<a href="/methods">How this is built</a>.
    </p>
    <p class="note measure">
      Report titles link to the report itself on the Parliament's website where the Tabled
      Documents index has it. That index begins in 2022, so reports tabled before then are
      listed here without a link rather than with a guessed one.
    </p>
    <p class="note measure">
      <em>Being considered</em> is the government’s own sentence, from its status report,
      not a characterisation of ours.
    </p>
    <RegisterControls target="house-register" noun="reports" />
    <table class="register stacks" id="house-register">
      <thead>
        <tr>
          <th scope="col" class="num">Waiting</th>
          <th scope="col">Report</th>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Tabled</th>
          <th scope="col">Status</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr
            data-days={r.daysOutstanding}
            data-title={r.title}
            data-committee={r.body}
            data-search={`${r.title} ${r.body} ${statusOf(r)} ${formatDateShort(r.owedSince)} ${r.owedSince}`.toLowerCase()}
          >
            <td class="num nowrap c-wait">
              {fmt(r.daysOutstanding)} days
              <span class="human">{humanDuration(r.daysOutstanding)}</span>
            </td>
            <td class="c-title">{r.url
              ? <a href={r.url} rel="external">{r.title}</a>
              : r.title}</td>
            <td class="cmte c-meta">{r.body}</td>
            <td class="num nowrap c-meta" data-label="Tabled">{formatDateShort(r.owedSince)}</td>
            <td class="src c-meta" data-label="Status">{statusOf(r)}</td>
            <td class="src c-meta" data-label="Source"><a href={sched.url} rel="external">Speaker’s schedule</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="by-committee">By committee</h2>
    <p class="note measure">
      Committees with reports still outstanding, most first.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Outstanding</th>
          <th scope="col" class="num">Longest wait</th>
        </tr>
      </thead>
      <tbody>
        {byCommittee.map((c) => (
          <tr>
            <td>{c.body}</td>
            <td class="num">{fmt(c.count)}</td>
            <td class="num nowrap">{fmt(c.longest)} days</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="compared">Compared with the Senate</h2>
    <p class="note measure">
      The two chambers are asked for different things: the Senate wants a response within
      three months, the House within six. So the two registers are not a league table, and
      the counts should not be added together without saying what each covers. Both are
      drawn from their presiding officer’s own record, and both currently stand as at
      {" "}{formatDate(sched.asAt)}. <a href="/senate/">The Senate register →</a>
    </p>
  </section>

  <section class="wrap">
    <p class="note measure">
      The whole register is available as CSV in the
      <a href="https://github.com/toohardbasket-lab/toohardbasket">public repository</a>,
      licensed CC BY 4.0. If you believe a row is wrong, please write to
      <a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a> —
      corrections are made within 24 hours of being confirmed and listed in the
      {" "}<a href="/corrections/">corrections log</a>.
    </p>
  </section>
</Base>

<style>
  .intro { padding-bottom: 1.5rem; }
  h2 { margin-top: 2.5rem; }
  .note { font-size: 0.875rem; color: var(--ink-muted); }


  table.register td { padding-right: 1rem; }
  .cmte, .src { color: var(--ink-secondary); font-size: 0.8125rem; }
  .nowrap { white-space: nowrap; }
  .human { display: block; font-size: 0.75rem; color: var(--ink-muted);
           font-variant-numeric: normal; }
  table.narrow { max-width: 44rem; }
</style>
