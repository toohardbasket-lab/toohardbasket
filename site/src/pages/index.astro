---
import Base from "../layouts/Base.astro";
import ResponsesChart from "../components/ResponsesChart.astro";
import Strip from "../components/Strip.astro";
import { LAUNCHED } from "../lib/launch";
import {
  homeFigures, complianceDetail, longestWaits, registerReportsWithoutSource, scheduleMeta,
  responsesByYear, typicalYear,
  humanDuration, inMonths, fmt, formatDate, formatDateShort,
} from "../lib/data";
import { registerBySlug } from "../lib/registers";
import { coverage, editions } from "../lib/data";
import PositionsBar from "../components/PositionsBar.astro";

const cov = coverage();
/* The latest frozen edition, which is what a citation should point at. */
const latestEdition = editions().at(-1);

/**
 * The home page covers both chambers, and does it without adding them together.
 *
 * The two counts are made under different rules — three months against six —
 * and on different scopes, because the President excludes categories of report
 * the Speaker does not. A single combined figure would imply one standard where
 * there are two, so the hero shows them side by side with the rule that governs
 * each. The one thing that is genuinely the same in both chambers is what the
 * government has said about the reports it has not answered, and that is the
 * line between them.
 */
const f = homeFigures();
const comp = complianceDetail();
const houseMeta = scheduleMeta("house");
const senateMeta = scheduleMeta("senate");
/* How much of each register is joint committee reports, said in the register's
   own numbers. It is most of the House register and nearly half of the
   Senate's, and this page used to say "most of both" — a claim the Senate
   page's own figures contradicted two clicks away. */
const onBoth = senateMeta.onBothRegisters || houseMeta.onBothRegisters || 0;
const senate = registerBySlug("senate")!;
const house = registerBySlug("house")!;
/**
 * The counts are as at today, not as at the schedules. Both presiding officers
 * reported at 30 June; every report answered since has come off. Dating the
 * hero 30 June would put a June label on a September number, which is the sort
 * of thing that gets a whole register doubted for one word.
 */
const asAt = formatDate(f.schedule.rebuilt ?? f.schedule.asAt);
/*
 * The rebuild date is not the data's date. Every run rewrites the meta file, so
 * the hero would say "as at 6 October" in a week when nothing new had been read
 * — which is the failure mode of a site whose whole subject is how long a thing
 * has been left. The date that matters is how far the responses have been read,
 * and both registers already publish it. It belongs where the reader looks
 * first.
 */
const checkedTo = [f.schedule.responsesCheckedTo, houseMeta.responsesCheckedTo]
  .filter(Boolean)
  .sort()[0];
const pct = (comp.rate * 100).toFixed(1);
const housePct = ((houseMeta.onTimeRate ?? 0) * 100).toFixed(0);
const longest = longestWaits(10);
/* Reports on either register the Tabled Documents index cannot supply, and so
   whose recommendations cannot be searched here. Counted, so the sentence that
   admits it disappears by itself once they have all been collected. */
const missing = registerReportsWithoutSource();
const oldest = longest[0];
/*
 * What the presiding officer's latest status report says about the longest
 * wait. Today that is "being considered", but the sentence has to follow the
 * row: the day this report is answered the next one takes its place, and the
 * fourth-longest is one the government has answered in part.
 */
const oldestStatus = oldest.beingConsidered
  ? "The government’s latest status report says its response is “being considered”."
  : oldest.partial
    ? "The government has answered some of its recommendations and not the rest, and the presiding officer still lists it as waiting."
    : oldest.interim
      ? "The government has sent an interim response, and the presiding officer still lists it as waiting."
      : "The government’s latest status report records nothing received.";

/**
 * The ten longest waits are, at the moment, all Senate reports — the Senate's
 * backlog reaches back to 2014 and the House's only to 2020. A table headed
 * "across both chambers" that shows one chamber looks broken, so say where the
 * other one starts rather than leaving the reader to wonder.
 */
const allWaits = longestWaits(400);
const firstHouseRank = allWaits.findIndex((r) => r.register === "house") + 1;
const firstHouse = allWaits[firstHouseRank - 1];
const chambersShown = new Set(longest.map((r) => r.register));

/**
 * The chart under the hero used to be the backlog. It fell from 346 to 82 and
 * read, to anyone who did not go on to the paragraph beneath it, as a
 * government catching up. Most of that fall was the government closing reports
 * with a form letter, and a backlog line cannot tell the two apart. Counting
 * the responses can: the volume is the tell. The backlog is still published,
 * on the Methods page, where the reconstruction and the President's own counts
 * can be set against each other at the length that needs.
 */
const perYear = responsesByYear();
const typical = typicalYear(perYear, "2023");

// House first, matching the nav. The order is the author's choice, not a
// judgement about which chamber matters more; what matters is that this
// and the nav never disagree.
const chambers = [
  {
    slug: "house",
    count: f.house.outstanding,
    name: house.name,
    rule: "The House asks for a response within six months.",
    overdue: f.house.overdue,
    href: "/house/",
    link: "The House register",
    ruleSince: house.ruleSince,
  },
  {
    slug: "senate",
    count: f.outstanding,
    name: senate.name,
    rule: "The Senate asks for a response within three months.",
    overdue: f.ledger.filter((r) => r.overdue).length,
    href: "/senate/",
    link: "The Senate register",
    ruleSince: senate.ruleSince,
  },
];
---

<Base
  title="Reports Parliament is still waiting on"
  description="A running count of the committee reports the Australian Government has not responded to, in both houses, how long each has waited, and how often the deadline is met."
>
  <section class="wrap hero">
    <p class="eyebrow">
      Awaiting a government response · as at {asAt}
      {checkedTo && <> · responses checked to {formatDate(checkedTo)}</>}
      {latestEdition && <> · <a href={`/as-at/${latestEdition.date}/#use`}>Cite this edition →</a></>}
    </p>
    {/*
      Two lines where there is room: the subject, then what is said of it.
      The break is set by hand because a measure cannot be trusted to put it
      after "government" at every size; on a narrow screen the break is
      dropped and the line wraps as it must.
    */}
    <h1 class="claim">Committee reports still waiting<br class="brk" />{" "}for a government response.</h1>

    <div class="chambers">
      {chambers.map((c) => (
        <div class="chamber" data-register={c.slug}>
          <p class="figure">{fmt(c.count)}</p>
          <p class="chamber-name">{c.name}</p>
          <p class="chamber-rule">
            {c.rule} {fmt(c.overdue)} of them are past it.
          </p>
          <p class="chamber-link"><a href={c.href}>{c.link} →</a></p>
        </div>
      ))}
    </div>

    {/*
      Two columns on a wide screen. The sentence about the longest wait is
      held to a readable measure, and under two full-width tiles that left the
      right half of a laptop screen empty. What fills it stays on the same
      subject: the paragraph that explains the phrase the sentence ends on,
      and the waits that come next — the answer to "is that one outlier?" —
      with a link down to the full table. On a phone it stacks in the same
      order.
    */}
    <div class="wait">
      <div class="gap measure" data-register={oldest.register}>
        {/*
          The clock, first, in the shape the tiles above use — a figure and
          then the words for it — at a size between the tiles and the sentence.
          The register counts whole days in Canberra, where the report was
          tabled, and so does this: the days figure is the calendar count and
          the line under it is how far into today Canberra is. It is the only
          number on the site that moves between builds; the register's own
          figure stands in for it until the script runs, and for anyone
          without one. Its line is its own, so a tick never reflows a word of
          the sentence.
        */}
        <p class="clock" data-tabled={oldest.owedSince}>
          <span class="clock-figure"><span class="clock-days">{fmt(oldest.daysOutstanding)}</span> <span class="clock-unit">days</span></span>
          <span class="clock-rest"><span class="clock-time" aria-hidden="true"></span><span class="clock-note">and counting</span></span>
          {oldest.url && (
            <span class="clock-link"><a href={oldest.url} rel="external">The report on aph.gov.au →</a></span>
          )}
        </p>
        <p class="sentence">
          The longest has been waiting <strong data-live-human={oldest.owedSince}>{humanDuration(oldest.daysOutstanding)}</strong>
          {" "}since the {oldest.body} committee tabled{" "}
          <em>{oldest.url ? <a href={oldest.url} rel="external">{oldest.title}</a> : oldest.title}</em>
          {" "}on {formatDate(oldest.owedSince)}. {oldestStatus}
        </p>
      </div>

      <div class="beside measure">
        {/*
          Named, not "That": since this paragraph moved beside the sentence
          rather than under it, a pronoun would point across the gutter at
          words the reader has not reached yet.
        */}
        <p class="lede">
          “Being considered” is the government’s own phrase, and it covers most of both registers:
          {" "}all {fmt(f.house.outstanding)} on the House register, where it is the only
          thing the government’s report can say about a report it has not answered, and
          {" "}{fmt(f.beingConsidered)} of the {fmt(f.outstanding)} reports on the Senate
          register.
          {" "}<a href="/senate/#outstanding">What it means on each register →</a>
        </p>
        <p class="next-head">And the next longest</p>
        <ul class="next">
          {longest.slice(1, 4).map((r) => (
            <li>
              <span class="next-days" data-live-days={r.owedSince}>{fmt(r.daysOutstanding)} days</span>
              <span class="next-what">
                <span class="reg-dot" data-register={r.register} aria-hidden="true"></span>{r.url ? <a href={r.url} rel="external">{r.title}</a> : r.title}
                <span class="next-meta"> · {r.body} · {formatDateShort(r.owedSince)}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="next-more"><a href="#longest">All ten, across both registers →</a></p>
      </div>
    </div>
  </section>

  {/*
    What this is, in two paragraphs, before any finding: a first-time reader
    should not have to scroll past a chart to learn what the page is.
  */}
  <section class="wrap what">
    <div class="measure">
    <h2>What this is</h2>
    <p>
      When a parliamentary committee reports, the government is expected to say what it
      will do about the recommendations. The Senate has asked for that within three
      months since {senate.ruleSince}; the House within six since {house.ruleSince}.
      Often the response does not come, or comes years later.
    </p>
    <p>
      This site is the list of reports still waiting, in both chambers, taken from the
      presiding officers’ own schedules and rebuilt every week, so the number on the page
      is what is outstanding now. It also reads every response tabled since 2022 and says
      what each one did. Every row links to the document it came from; the whole dataset
      is <a href="https://github.com/toohardbasket-lab/toohardbasket">public</a> and
      corrections are <a href="/corrections/">logged</a>. Nothing here is an opinion about
      any recommendation: only whether an answer was given, and when.
    </p>
    </div>
    {/* The finding beside it, and before the chart that shows it as a volume event. */}
    <div class="measure">
      <Strip />
    </div>
  </section>

  <section class="wrap">
    <ResponsesChart
      rows={perYear}
      typical={typical}
      checkedTo={formatDate(f.schedule.responsesCheckedTo ?? f.schedule.asAt)}
    />
  </section>

  {/* Two findings side by side where there is room; stacked on a phone. */}
  <section class="wrap findings">
    <div class="measure">
    <h2>Whether the deadline was met</h2>
    <p>
      Of {fmt(comp.assessable)} responses to Senate committee reports tabled between
      {" "}{comp.firstYear} and {comp.lastYear}, {fmt(comp.onTime)} arrived inside the
      required three months: {pct} per cent. The median took {fmt(comp.medianDays)} days.
      More than half took longer than a year.
    </p>
    <p>
      The House keeps no comparable record going back that far. The Speaker’s schedule
      counts only the responses received since the previous schedule: of those
      {" "}{fmt(houseMeta.answeredWithVerdict ?? 0)},
      {" "}{fmt(houseMeta.answeredOnTime ?? 0)} arrived within six months, {housePct} per
      cent. That covers months, not decades, so the two figures are not comparable.
    </p>
    <p>
      This is not about one government. Attribute every late response to
      whoever tabled it, or to whoever was in office when the report was tabled: the
      two readings disagree about which government performs worst, and on neither
      reading does any of the four reach one response in ten inside the deadline.
      {" "}<a href="/senate/#compliance">Both readings, side by side →</a>
    </p>
    </div>
    {LAUNCHED && cov && cov.total.coverage !== null && (
      <div class="measure">
        <h2>Whether a position was stated</h2>
        <p>
          A response arriving is not the same as a report being answered. Recommendation by
          recommendation, {fmt(cov.total.positionStated)} of the {fmt(cov.total.recommendations)}
          {" "}this site can show received a stated position: {(cov.total.coverage * 100).toFixed(0)} per
          cent. {fmt(cov.total.accepted)} were accepted outright, {fmt(cov.total.inPartOrInPrinciple)} in
          part or in principle, and {fmt(cov.total.notAccepted)} not accepted. The rest were noted
          without a position, closed with the form letter, or passed over by a response that answered
          the report as a whole.
        </p>
        <PositionsBar total={cov.total} id="home-positions" compact />
        <p>
          <a href="/senate/responses/#coverage">How that is counted →</a>
        </p>
      </div>
    )}
  </section>

  <section class="wrap longest" id="longest">
    <h2>Longest outstanding</h2>
    <p class="note measure">
      Across both registers. The counts are kept apart because the rules differ and
      because a joint committee report is listed by both presiding officers
      ({fmt(onBoth)} reports are on both registers). A wait is measured the same way on
      either register, so this table ranks reports from both.
      {chambersShown.size === 1 && firstHouse && (
        <>
          {" "}All ten are from the Senate register, which reaches back to
          {" "}{oldest.owedSince.slice(0, 4)} where the
          House register stops at {firstHouse.owedSince.slice(0, 4)}. That does not mean the
          House does better: in 2023 its committee chairs agreed to recommend taking every report presented
          before July 2019 off the schedule unless the committee that made it asked to keep
          it there.{" "}<a href="/house/#source">Why the House list is shorter →</a>
          {" "}The longest-waiting report on the House register,{" "}
          <em>{firstHouse.url ? <a href={firstHouse.url} rel="external">{firstHouse.title}</a> : firstHouse.title}</em> at <span data-live-days={firstHouse.owedSince}>{fmt(firstHouse.daysOutstanding)} days</span>, comes
          {" "}{firstHouseRank}th here.
        </>
      )}
    </p>
    <table class="register stacks">
      <caption class="sr-only">The ten longest-waiting reports across both registers</caption>
      <thead>
        <tr>
          <th scope="col" class="num">Waiting</th>
          <th scope="col">Report</th>
          <th scope="col">Committee</th>
          <th scope="col">Register</th>
          <th scope="col" class="num">Tabled</th>
        </tr>
      </thead>
      <tbody>
        {longest.map((r) => (
          <tr>
            <td class="num nowrap c-wait"><span data-live-days={r.owedSince}>{fmt(r.daysOutstanding)} days</span></td>
            <td class="c-title">{r.url ? <a href={r.url} rel="external">{r.title}</a> : r.title}</td>
            <td class="cmte c-meta">{r.body}</td>
            <td class="cmte c-meta" data-label="Register">
              <span class="reg-dot" data-register={r.register} aria-hidden="true"></span>{r.register === "house" ? "House" : "Senate"}
              {r.alsoOnOther && <span class="both"> · and {r.register === "house" ? "Senate" : "House"}</span>}
            </td>
            <td class="num nowrap c-meta" data-label="Tabled">{formatDateShort(r.owedSince)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {missing.predating > 0 && (
      <p class="note measure">
        <strong>{missing.predating === 1 ? "One report in this table is" : "Some reports in this table are"} not yet searchable.</strong>
        {" "}The <a href="/recommendations/">recommendations index</a> reads reports from the
        Parliament’s Tabled Documents register, which holds nothing before 2022. The reports
        older than that were fetched from their committees’ own pages instead;
        {" "}{missing.predating === 1 ? "one" : fmt(missing.predating)} {missing.predating === 1 ? "has" : "have"} not been
        found yet, so what {missing.predating === 1 ? "that committee" : "those committees"}
        {" "}recommended cannot be searched here.
      </p>
    )}
    <p class="more">
      <a href="/house/">All {fmt(f.house.outstanding)} in the House register →</a>{" "}
      <a href="/senate/">All {fmt(f.outstanding)} in the Senate register →</a>
    </p>
  </section>
</Base>

<script>
  // The live clock under the longest wait, kept in Canberra time whoever is
  // reading. The days figure is the calendar count from the day the report
  // was tabled — the register's own arithmetic, so it agrees with the table
  // on the day the register is rebuilt and runs one ahead of it by the week's
  // end — and the rest is how far into today Canberra is, written out in
  // words so that nobody reads it as a clock showing the wrong time. The
  // first version printed "18:15:36" beside the days, which in Perth at 15:15
  // and in Canberra at 17:15 looked broken, because it was measured from a
  // summer-time midnight.
  const el = document.querySelector<HTMLElement>(".clock");
  if (el && el.dataset.tabled) {
    const [ty, tm, td] = el.dataset.tabled.split("-").map(Number);
    const tabled = Date.UTC(ty, tm - 1, td);
    const days = el.querySelector<HTMLElement>(".clock-days")!;
    const time = el.querySelector<HTMLElement>(".clock-time")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canberra = new Intl.DateTimeFormat("en-AU", {
      timeZone: "Australia/Canberra", hourCycle: "h23",
      year: "numeric", month: "numeric", day: "numeric",
      hour: "numeric", minute: "numeric", second: "numeric",
    });
    const unit = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
    const tick = () => {
      const p: Record<string, number> = {};
      for (const part of canberra.formatToParts(new Date())) {
        if (part.type !== "literal") p[part.type] = Number(part.value);
      }
      const d = Math.round((Date.UTC(p.year, p.month - 1, p.day) - tabled) / 86_400_000);
      days.textContent = d.toLocaleString("en-AU");
      time.textContent = reduced
        ? `${unit(p.hour, "hour")} and ${unit(p.minute, "minute")} — `
        : `${unit(p.hour, "hour")}, ${unit(p.minute, "minute")} and ${unit(p.second, "second")} — `;
    };
    tick();
    setInterval(tick, reduced ? 60_000 : 1000);
  }
</script>

<style>
  .hero { padding-bottom: 2.5rem; }
  .claim {
    font-size: clamp(1.375rem, 1rem + 1.2vw, 1.9rem); font-weight: 600;
    max-width: 26ch; margin: 0.15rem 0 1.75rem;
  }
  .claim .brk { display: none; }
  @media (min-width: 44rem) {
    .claim { max-width: none; }
    .claim .brk { display: inline; }
  }

  .chambers {
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }
  .chamber { background: var(--surface); padding: 1.25rem 1.25rem 1.4rem; border-top: 3px solid var(--rule); }
  /* The chamber's colour rules its tile and names it; the figure stays in ink. */
  .chamber[data-register="senate"] { border-top-color: var(--senate); }
  .chamber[data-register="house"] { border-top-color: var(--house); }
  .chamber[data-register="senate"] .chamber-name { color: var(--senate); }
  .chamber[data-register="house"] .chamber-name { color: var(--house); }
  /* Hero figure: same sans, tabular figures, one per chamber. */
  .figure {
    font-size: clamp(3rem, 1.6rem + 6vw, 4.75rem);
    line-height: 0.95; font-weight: 650; letter-spacing: -0.035em;
    margin: 0 0 0.4rem; font-variant-numeric: tabular-nums;
  }
  .chamber-name { margin: 0 0 0.3rem; font-weight: 600; font-size: 1.0625rem; }
  .chamber-rule { margin: 0; font-size: 0.875rem; color: var(--ink-secondary); line-height: 1.5; }
  .chamber-link { margin: 0.7rem 0 0; font-size: 0.875rem; }

  .hero .lede em { font-style: normal; color: var(--ink); }
  /* The longest wait and what sits beside it: one column until the screen is
     wide enough for the sentence to keep its measure with room to spare. */
  .wait { margin-top: 1.75rem; }
  @media (min-width: 62rem) {
    .wait { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 3rem; align-items: start; }
    .beside { margin-top: 0.35rem; }
  }
  .gap {
    margin: 0;
    padding-left: 0.9rem; border-left: 2px solid var(--series-1);
  }
  .gap .sentence {
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.45; margin: 0;
  }
  .gap[data-register="senate"] { border-left-color: var(--senate); }
  .gap[data-register="house"] { border-left-color: var(--house); }
  /*
   * The clock: the days as a figure in the tiles' own style, a size below
   * them and above the sentence; then the hours, minutes and seconds in
   * words on a line of their own, so nothing reflows when they tick.
   * Decorative beyond the days figure — the time is aria-hidden — and it
   * stops at minutes for anyone who has asked for less motion.
   */
  .gap .clock { font-family: var(--sans); margin: 0 0 0.75rem; }
  .clock-figure {
    display: block; line-height: 1; letter-spacing: -0.03em;
    font-size: clamp(2.5rem, 1.5rem + 3.2vw, 3.75rem); font-weight: 650;
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .clock-unit { font-size: 0.5em; font-weight: 500; letter-spacing: 0; color: var(--ink-secondary); }
  .clock-rest {
    display: block; margin-top: 0.5rem;
    font-size: 1.0625rem; line-height: 1.5; color: var(--ink-secondary);
    font-variant-numeric: tabular-nums;
  }
  .clock-note { color: var(--ink-muted); }
  .clock-link { display: block; margin-top: 0.35rem; font-size: 0.875rem; }
  .hero .lede { margin: 1.25rem 0 0; font-size: 0.9375rem; color: var(--ink-secondary); }
  @media (min-width: 62rem) { .hero .lede { margin-top: 0; } }
  /* The next-longest waits: a rail, not a table — days in the sans, the
     report in the serif, the chamber's dot before it as everywhere else. */
  .next-head {
    font-family: var(--sans); font-size: 0.6875rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-muted); margin: 1.5rem 0 0.35rem;
  }
  .next { list-style: none; margin: 0; padding: 0; font-size: 0.875rem; line-height: 1.4; }
  .next li {
    display: grid; grid-template-columns: 5.75rem 1fr; gap: 0.75rem;
    padding: 0.45rem 0; border-top: 1px solid var(--rule);
  }
  .next-days { font-family: var(--sans); font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
  .next-meta { color: var(--ink-muted); }
  .next-more { font-family: var(--sans); font-size: 0.875rem; margin: 0.6rem 0 0; }

  .what {
    display: grid; gap: 2rem 3rem; margin-top: 2.5rem; padding-top: 2rem;
    border-top: 1px solid var(--rule);
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  .what h2, .findings h2 { margin-bottom: 0.5rem; }
  .findings {
    display: grid; gap: 2rem 3rem; margin-top: 2.5rem; padding-top: 2rem;
    border-top: 1px solid var(--rule);
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  .findings h2 + p { margin-top: 0; }

  .longest h2 { margin-bottom: 0.5rem; }
  .longest .note { font-size: 0.875rem; color: var(--ink-secondary); margin-bottom: 1rem; }
  .longest .cmte { color: var(--ink-secondary); font-size: 0.875rem; }
  .longest .both { color: var(--ink-muted); }
