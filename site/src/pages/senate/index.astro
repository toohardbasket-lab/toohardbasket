---
import Base from "../../layouts/Base.astro";
import RegisterControls from "../../components/RegisterControls.astro";
import StatTiles from "../../components/StatTiles.astro";
import AnsweredSinceList from "../../components/AnsweredSince.astro";
import { ledger, answeredSince, complianceDetail, history, humanDuration, fmt, formatDate, formatDateShort, inMonths, scheduleMeta } from "../../lib/data";
import { registerBySlug } from "../../lib/registers";
import { LAUNCHED } from "../../lib/launch";

const reg = registerBySlug("senate")!;
const rows = ledger();
const comp = complianceDetail();
const observed = history().filter((p) => p.basis === "observed").at(-1);
const asAt = formatDate(observed?.asAt ?? new Date().toISOString().slice(0, 10));

const sched = scheduleMeta();
const removedSince = answeredSince("senate");
const overFive = rows.filter((r) => r.daysOutstanding > 1826);
/* The scale the waiting bars are drawn against: the longest wait on this
   register, so each bar is that report's share of the worst case rather than a
   number scaled to nothing. Guarded, because an empty register has no longest. */
const longestWait = Math.max(1, ...rows.map((r) => r.daysOutstanding || 0));
const overOne = rows.filter((r) => r.daysOutstanding > 365);
const considered = rows.filter((r) => r.beingConsidered);
const overdue = rows.filter((r) => r.overdue);
const withinTime = rows.filter((r) => !r.overdue);

/**
 * The same six figures, in the same order, as the House register. Only the
 * deadline differs, because the chambers ask for different things — and the
 * compliance rate is not among them: it measures 26 years of responses, not
 * what is owed now, and it has its own section below.
 */
const stats = [
  { label: "Awaiting a response", value: fmt(rows.length) },
  { label: "Told it is being considered", value: fmt(considered.length) },
  { label: "Past the three-month deadline", value: fmt(overdue.length) },
  { label: "Still within time", value: fmt(withinTime.length) },
  { label: "Waiting over a year", value: fmt(overOne.length) },
  { label: "Waiting over five years", value: fmt(overFive.length) },
  { label: "Met the deadline", value: `${(comp.rate * 100).toFixed(1)}%` },
];
const statsNote =
  `Met the deadline is the only figure here not drawn from the current schedule: ` +
  `it is every response since ${comp.firstYear} whose report date the Senate's register ` +
  `records — ${fmt(comp.onTime)} of ${fmt(comp.assessable)} arrived within three months. ` +
  `The other six describe what is owed today.`;

/** The status column of the schedule, in the register's own words. */
const statusOf = (r: (typeof rows)[number]): string =>
  r.beingConsidered ? "Being considered"
  : r.partial ? "Answered in part"
  : r.interim ? "Interim response"
  : "Nothing received";

// Committees ranked by how much is outstanding against them.
const byCommittee = [...rows.reduce((m, r) => {
  const cur = m.get(r.body) ?? { body: r.body, count: 0, longest: 0 };
  cur.count += 1;
  cur.longest = Math.max(cur.longest, r.daysOutstanding);
  return m.set(r.body, cur);
}, new Map<string, { body: string; count: number; longest: number }>()).values()]
  .sort((a, b) => b.count - a.count || b.longest - a.longest);
---

<Base
  title={`The Senate register`}
  description={`Every ${reg.name.toLowerCase()} still awaiting a government response, how long each has waited, and where the record comes from.`}
>
  <section class="wrap intro">
    <p class="eyebrow">
      <span class="reg-label" data-register="senate">Register · {reg.claimant}</span> · the President’s report as at {formatDate(sched.asAt)}
      {sched.responsesCheckedTo && <> · responses checked to {formatDate(sched.responsesCheckedTo)}</>}
    </p>
    <h1>The Senate register</h1>
    <p class="lede measure">
      Every Senate committee report the President of the Senate records as still
      waiting for a government response. The Senate has required {reg.rule} since
      {" "}{reg.ruleSince}. A report leaves this register when a response is tabled —
      whatever that response says.
    </p>

    <StatTiles stats={stats} note={statsNote} register="senate" />
  </section>


  <section class="wrap">
    <h2 id="outstanding">Outstanding reports</h2>
    <p class="note measure">
      Ordered by how long each has waited. The status column is the President’s own:
      {" "}<em>being considered</em> is what he records as “Interim*”, and defines in his
      report as the government saying only that “the Government’s response is being
      considered”.{" "}<a href="/methods">How this is built</a>.
    </p>
    {sched.beingConsideredAsAt && (
      <p class="note measure">
        <strong>That column has its own date.</strong> The President takes those marks from
        the government’s own status report, which he says on his second page should be read
        with his: it is as at {formatDate(sched.beingConsideredAsAt)} and was tabled on
        {" "}{formatDate(sched.beingConsideredTabled ?? "")}, where this register is as at
        {" "}{formatDate(sched.asAt)}. A report tabled after
        {" "}{formatDate(sched.beingConsideredAsAt)} has not been through a status cycle
        yet, so “nothing received” against a recent report means the government has not yet
        been asked to say, not that it has refused to.
      </p>
    )}
    <p class="note measure">
      Every row below comes from
      {" "}<a href={sched.url} rel="external">the President’s report as at {formatDate(sched.asAt)}</a>,
      except any marked as the Senate tracker’s. Report titles link to the report itself on
      the Parliament’s website where the Tabled Documents index has it. That index begins in
      2022, so reports tabled before then are listed here without a link rather than with a
      guessed one.
    </p>
    <RegisterControls target="senate-register" noun="reports" />
    <table class="register stacks" id="senate-register" data-register="senate">
      <thead>
        <tr>
          <th scope="col" class="num">Waiting</th>
          <th scope="col">Report</th>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Tabled</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr
            data-days={r.daysOutstanding}
            data-title={r.title}
            data-committee={r.body}
            data-search={`${r.title} ${r.body} ${statusOf(r)} ${formatDateShort(r.owedSince)} ${r.owedSince}`.toLowerCase()}
          >
            <td class="num nowrap c-wait">
              <span data-live-days={r.owedSince}>{fmt(r.daysOutstanding)} days</span>
              <span class="human" data-live-human={r.owedSince}>{humanDuration(r.daysOutstanding)}</span>
              <span class="bar" aria-hidden="true"
                    style={`width: ${Math.max(2, Math.round((r.daysOutstanding / longestWait) * 100))}%`}></span>
            </td>
            <td class="c-title">{r.url
              ? <a href={r.url} rel="external">{r.title}</a>
              : r.title}{!r.source.startsWith("presidents") && (
                <span class="from-tracker" title="Tabled after the President's report; carried from the Senate's live tracker">
                  {" "}Senate tracker
                </span>
              )}</td>
            <td class="cmte c-meta">{r.body}</td>
            <td class="num nowrap c-meta" data-label="Tabled">{formatDateShort(r.owedSince)}</td>
            <td class="src c-meta" data-label="Status">{statusOf(r)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="source">Where this comes from, and what it leaves out</h2>
    {(sched.editionsRead ?? 0) > 1 && (
      <p class="note measure">
        <strong>How long it has been saying it.</strong> The President has tabled
        {" "}{fmt(sched.editionsRead ?? 0)} of these reports since
        {" "}{formatDate(sched.editionsFrom ?? "")}, and every one of them is on the public
        record. Reading all {fmt(sched.editionsRead ?? 0)}:
        {" "}<strong>{fmt(sched.consideredEveryEdition ?? 0)}</strong> of the reports below
        have been marked “being considered” in every single edition — the government has said
        the same thing about them, twice a year, for {sched.editionsRead === 9 ? "four" : ""}
        {" "}years. That is a count of consecutive editions, not an estimate: where a report’s
        title is written differently in an older edition the run is broken and counted short.
      </p>
    )}
    <p class="note measure">
      This register publishes what the presiding officer records, and nothing else.
      Twice a year the President reports to the Senate on the status of every committee
      report that requires a government response. The most recent is
      {" "}<a href={sched.url}>the report as at {formatDate(sched.asAt)}</a>, tabled on
      {" "}{formatDate(sched.tabled)}. It lists {fmt(sched.listed)} reports, records a
      response received for {fmt(sched.answeredAtSchedule)}, and leaves
      {" "}<strong>{fmt(sched.listed - sched.answeredAtSchedule)}</strong> still waiting at
      that date.
    </p>
    <p class="note measure">
      Since that date {fmt(sched.answeredSince)} of
      those {sched.answeredSince === 1 ? "has" : "have"} been answered, and those reports
      have been removed — a report the government has answered must not be published here
      as waiting. That is why this register shows <strong>{fmt(rows.length)}</strong> today
      where the President recorded {fmt(sched.listed - sched.answeredAtSchedule)} at
      {" "}{formatDate(sched.asAt)}. The Senate also runs a live tracker of reports awaiting a
      response; it is carried here only for reports tabled after the President’s date, so it
      can add to the register but never overrule it.
      {sched.fromTracker === 0
        ? " On this build it adds nothing, and every row below is the President’s."
        : ` On this build it adds ${fmt(sched.fromTracker)} ${sched.fromTracker === 1 ? "report" : "reports"}, marked below as the tracker's.`}
    </p>
    <AnsweredSinceList rows={removedSince} officer="the President" />
    {sched.responsesCheckedTo && (
      <p class="note measure">
        <strong>How current that is.</strong> A register is only as current as the responses
        it has seen. This build checked every government response tabled up to
        {" "}{formatDate(sched.responsesCheckedTo)}; a response tabled after that date will
        not have removed its report yet, and will do so on the next rebuild.
      </p>
    )}
    {sched.officersDisagree > 0 && (
      <p class="note measure">
        <strong>The two officers do not always agree.</strong> The Speaker records
        {" "}{sched.officersDisagree === 1 ? "one report" : `${fmt(sched.officersDisagree)} reports`}
        {" "}as fully responded to that the President still lists as awaiting a response in
        part — Public Accounts and Audit reports
        {" "}{sched.officersDisagreeReports.join(", ")}, answered by executive minute one
        recommendation at a time. Executive minutes are the one thing this
      register cannot see arriving: they are tabled by the committee rather than as a
      government response, so a report answered that way stays here until the presiding
      officer’s next schedule records it. Neither record is edited here. The Senate register follows
        the President and the House register follows the Speaker, which is why the same
        report can be waiting on one page and answered on the other.
      </p>
    )}
    <p class="note measure">
      <strong>Most of what is here is not the Senate's own.</strong> A joint committee
      reports to both houses, so its report is listed by both presiding officers:
      {" "}{fmt(sched.jointCommittee)} of the {fmt(rows.length)} reports below are joint
      committee reports — the President titles his own document “Senate and joint
      committee reports” — and {fmt(sched.onBothRegisters)} of them are on
      {" "}<a href="/house/">the House register</a> as well. That is why the two counts
      are never added: it would count the same report twice. The two lists do not contain the same joint reports,
      and they are not meant to: the President and the Speaker exclude different categories,
      the House removed everything presented before July 2019 and the Senate did not, and on
      three reports the two officers disagree about whether a response has been received. So
      a joint report can be on one register and not the other without either being wrong.
      {sched.deadlineDiffers > 0 && (
        <>
          {" "}It is also why the same report can be past the deadline on one register and
          within time on the other — the Senate counts three months from Senate tabling,
          the House six from House presentation, and
          {" "}{sched.deadlineDiffers === 1 ? "one report is" : `${fmt(sched.deadlineDiffers)} reports are`}
          {" "}in that position today.
        </>
      )}
    </p>
    <p class="note measure">
      <strong>What it does not have:</strong> reports tabled after
      {" "}{formatDate(sched.coversTo)}, which neither source yet lists; anything the
      President excludes from his report, which includes reports on bills whose
      recommendations can only be dealt with in debate, estimates and annual-report
      scrutiny, and the Senate’s domestic committees; and the House of Representatives,
      which has its own presiding officer, its own schedule and its own six-month rule.
    </p>
  </section>

  <section class="wrap">
    <h2 id="by-committee">By committee</h2>
    <p class="note measure">
      Committees with reports still outstanding, most first.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Outstanding</th>
          <th scope="col" class="num">Longest wait</th>
        </tr>
      </thead>
      <tbody>
        {byCommittee.map((c) => (
          <tr>
            <td>{c.body}</td>
            <td class="num">{fmt(c.count)}</td>
            <td class="num nowrap">{fmt(c.longest)} days</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="compliance">Whether the deadline is met</h2>
    <p class="note measure">
      The register above is what is owed now. This is the record over
      {" "}{comp.lastYear - comp.firstYear} years: every response tabled between{" "}
      {comp.firstYear} and {comp.lastYear} whose report date the Senate’s register records —
      {" "}{fmt(comp.assessable)} of them — measured against the three-month rule. The interval
      runs from the report’s last tabling, which is the reading most favourable to the
      government. <a href="/methods#limits">What this does and does not count</a>.
    </p>

    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Time taken to respond</th>
          <th scope="col" class="num">Responses</th>
          <th scope="col" class="num">Share</th>
        </tr>
      </thead>
      <tbody>
        {comp.buckets.map((b) => (
          <tr>
            <td>{b.label}</td>
            <td class="num">{fmt(b.count)}</td>
            <td class="num">{(b.share * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note measure">
      Median: {fmt(comp.medianDays)} days, or about {inMonths(comp.medianDays)}, against a
      rule of three.
    </p>
    {LAUNCHED && (
      <p class="note measure">
        This measures only whether a response arrived, not whether it answered anything.
        {" "}<a href="/senate/responses/">How the government answered →</a>
      </p>
    )}

    <h3 id="by-government">By government</h3>
    <p class="note measure">
      A late response can be attributed to the government that tabled it, or to the government
      in office when the report was tabled. The two readings disagree about who performs worst,
      and the disagreement is the point: the ordering is an artefact of the choice, while the
      range — never above single figures — is not. Both are shown so that neither can be quoted
      alone.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Government</th>
          <th scope="col" class="num">Responses tabled</th>
          <th scope="col" class="num">Met the rule</th>
          <th scope="col" class="num">Reports tabled</th>
          <th scope="col" class="num">Met the rule</th>
        </tr>
      </thead>
      <tbody>
        {comp.governments.map((g) => (
          <tr>
            <td>{g.name}</td>
            <td class="num">{fmt(g.byResponse.n)}</td>
            <td class="num">{(g.byResponse.rate * 100).toFixed(1)}%</td>
            <td class="num">{fmt(g.byReport.n)}</td>
            <td class="num">{(g.byReport.rate * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note measure">
      Columns two and three count responses by who tabled them; columns four and five count
      them by who was in office when the report was tabled. No government in
      {" "}{comp.lastYear - comp.firstYear} years reaches one response in ten inside the deadline,
      on either reading.
    </p>
  </section>

  <section class="wrap">
    <p class="note measure">
      The whole register is available as CSV in the{" "}
      <a href="https://github.com/toohardbasket-lab/toohardbasket">public repository</a>,
      licensed CC BY 4.0. If you believe a row is wrong, please write to{" "}
      <a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a> —
      corrections are made within 24 hours of being confirmed and listed in the
      {" "}<a href="/corrections/">corrections log</a>.
    </p>
  </section>
</Base>

<style>
  /* The source used to be a column, which printed the same words on all 82
     rows and, stacked on a phone, printed the label above them as well. It is
     stated once above the table now, and only the rows that differ carry a
     mark. */
  .from-tracker {
    display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem;
    font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--ink-muted);
    border: 1px solid var(--rule-strong); border-radius: 2px; vertical-align: 0.12em;
    white-space: nowrap;
  }
  .intro { padding-bottom: 1.5rem; }
  h2 { margin-top: 2.5rem; }
  .note { font-size: 0.875rem; color: var(--ink-secondary); }


  table.register td { padding-right: 1rem; }
  .cmte, .src { color: var(--ink-secondary); font-size: 0.875rem; }
  .nowrap { white-space: nowrap; }
  .human { display: block; font-size: 0.75rem; color: var(--ink-muted);
           font-variant-numeric: normal; }
  table.narrow { max-width: 44rem; }
</style>
