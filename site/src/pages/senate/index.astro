---
import Base from "../../layouts/Base.astro";
import { ledger, compliance, history, humanDuration, fmt, formatDate, formatDateShort } from "../../lib/data";
import { registerBySlug } from "../../lib/registers";

const reg = registerBySlug("senate")!;
const rows = ledger();
const comp = compliance();
const observed = history().filter((p) => p.basis === "observed").at(-1);
const asAt = formatDate(observed?.asAt ?? new Date().toISOString().slice(0, 10));

const overFive = rows.filter((r) => r.daysOutstanding > 1826);
const overOne = rows.filter((r) => r.daysOutstanding > 365);

// Committees ranked by how much is outstanding against them.
const byCommittee = [...rows.reduce((m, r) => {
  const cur = m.get(r.body) ?? { body: r.body, count: 0, longest: 0 };
  cur.count += 1;
  cur.longest = Math.max(cur.longest, r.daysOutstanding);
  return m.set(r.body, cur);
}, new Map<string, { body: string; count: number; longest: number }>()).values()]
  .sort((a, b) => b.count - a.count || b.longest - a.longest);
---

<Base
  title={`The Senate register`}
  description={`Every ${reg.name.toLowerCase()} still awaiting a government response, how long each has waited, and where the record comes from.`}
>
  <section class="wrap intro">
    <p class="eyebrow">Register · {reg.claimant} · as at {asAt}</p>
    <h1>The Senate register</h1>
    <p class="lede measure">
      Every Senate committee report still waiting for a government response.
      The Senate has required {reg.rule} since {reg.ruleSince}. A report leaves
      this register when a response is tabled — whatever that response says.
    </p>

    <dl class="stats">
      <div><dt>Awaiting a response</dt><dd class="num">{fmt(rows.length)}</dd></div>
      <div><dt>Waiting over a year</dt><dd class="num">{fmt(overOne.length)}</dd></div>
      <div><dt>Waiting over five years</dt><dd class="num">{fmt(overFive.length)}</dd></div>
      <div><dt>Met the three-month deadline</dt><dd class="num">{(comp.rate * 100).toFixed(1)}%</dd></div>
    </dl>
  </section>

  <section class="wrap">
    <h2 id="outstanding">Outstanding reports</h2>
    <p class="note measure">
      Ordered by how long each has waited. Sourced from the President of the Senate’s
      twice-yearly schedule of outstanding responses and the Senate’s live tracker;
      each row names which. <a href="/methods">How this is built</a>.
    </p>
    <table class="register">
      <thead>
        <tr>
          <th scope="col" class="num">Waiting</th>
          <th scope="col">Report</th>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Tabled</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="num nowrap">
              {fmt(r.daysOutstanding)} days
              <span class="human">{humanDuration(r.daysOutstanding)}</span>
            </td>
            <td>{r.title}</td>
            <td class="cmte">{r.body}</td>
            <td class="num nowrap">{formatDateShort(r.owedSince)}</td>
            <td class="src">{r.source.startsWith("presidents") ? "President’s schedule" : "Senate tracker"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="by-committee">By committee</h2>
    <p class="note measure">
      Committees with reports still outstanding, most first.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Outstanding</th>
          <th scope="col" class="num">Longest wait</th>
        </tr>
      </thead>
      <tbody>
        {byCommittee.map((c) => (
          <tr>
            <td>{c.body}</td>
            <td class="num">{fmt(c.count)}</td>
            <td class="num nowrap">{fmt(c.longest)} days</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <p class="note measure">
      The whole register is available as CSV in the
      <a href="https://github.com/toohardbasket-lab/toohardbasket">public repository</a>,
      licensed CC BY 4.0. If you believe a row is wrong, please write to
      <a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a> —
      corrections are made within 24 hours and logged.
    </p>
  </section>
</Base>

<style>
  .intro { padding-bottom: 1.5rem; }
  h2 { margin-top: 2.5rem; }
  .note { font-size: 0.875rem; color: var(--ink-muted); }

  .stats {
    display: grid; gap: 1px; margin: 2rem 0 0;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    background: var(--rule); border-block: 1px solid var(--rule);
  }
  .stats > div { background: var(--surface); padding: 0.9rem 1rem 1rem 0; }
  .stats dt { font-size: 0.6875rem; letter-spacing: 0.09em; text-transform: uppercase;
              color: var(--ink-muted); margin-bottom: 0.35rem; }
  .stats dd { margin: 0; font-size: 1.375rem; font-weight: 600; }

  table.register td { padding-right: 1rem; }
  .cmte, .src { color: var(--ink-secondary); font-size: 0.8125rem; }
  .nowrap { white-space: nowrap; }
  .human { display: block; font-size: 0.75rem; color: var(--ink-muted);
           font-variant-numeric: normal; }
  table.narrow { max-width: 44rem; }
</style>
