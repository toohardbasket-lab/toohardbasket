---
import Base from "../../layouts/Base.astro";
import RegisterControls from "../../components/RegisterControls.astro";
import StatTiles from "../../components/StatTiles.astro";
import { ledger, complianceDetail, history, humanDuration, fmt, formatDate, formatDateShort, inMonths, scheduleMeta } from "../../lib/data";
import { registerBySlug } from "../../lib/registers";
import { LAUNCHED } from "../../lib/launch";

const reg = registerBySlug("senate")!;
const rows = ledger();
const comp = complianceDetail();
const observed = history().filter((p) => p.basis === "observed").at(-1);
const asAt = formatDate(observed?.asAt ?? new Date().toISOString().slice(0, 10));

const sched = scheduleMeta();
const overFive = rows.filter((r) => r.daysOutstanding > 1826);
const overOne = rows.filter((r) => r.daysOutstanding > 365);
const considered = rows.filter((r) => r.beingConsidered);
const overdue = rows.filter((r) => r.overdue);
const withinTime = rows.filter((r) => !r.overdue);

/**
 * The same six figures, in the same order, as the House register. Only the
 * deadline differs, because the chambers ask for different things — and the
 * compliance rate is not among them: it measures 26 years of responses, not
 * what is owed now, and it has its own section below.
 */
const stats = [
  { label: "Awaiting a response", value: fmt(rows.length) },
  { label: "Told it is being considered", value: fmt(considered.length) },
  { label: "Past the three-month deadline", value: fmt(overdue.length) },
  { label: "Still within time", value: fmt(withinTime.length) },
  { label: "Waiting over a year", value: fmt(overOne.length) },
  { label: "Waiting over five years", value: fmt(overFive.length) },
  { label: "Met the deadline", value: `${(comp.rate * 100).toFixed(1)}%` },
];
const statsNote =
  `Met the deadline is the only figure here not drawn from the current schedule: ` +
  `it is every response since ${comp.firstYear} whose report date the Senate's register ` +
  `records — ${fmt(comp.onTime)} of ${fmt(comp.assessable)} arrived within three months. ` +
  `The other five describe what is owed today.`;

/** The status column of the schedule, in the register's own words. */
const statusOf = (r: (typeof rows)[number]): string =>
  r.beingConsidered ? "Being considered"
  : r.partial ? "Answered in part"
  : r.interim ? "Interim response"
  : "Nothing received";

// Committees ranked by how much is outstanding against them.
const byCommittee = [...rows.reduce((m, r) => {
  const cur = m.get(r.body) ?? { body: r.body, count: 0, longest: 0 };
  cur.count += 1;
  cur.longest = Math.max(cur.longest, r.daysOutstanding);
  return m.set(r.body, cur);
}, new Map<string, { body: string; count: number; longest: number }>()).values()]
  .sort((a, b) => b.count - a.count || b.longest - a.longest);
---

<Base
  title={`The Senate register`}
  description={`Every ${reg.name.toLowerCase()} still awaiting a government response, how long each has waited, and where the record comes from.`}
>
  <section class="wrap intro">
    <p class="eyebrow">
      Register · {reg.claimant} · the President’s report as at {formatDate(sched.asAt)}
    </p>
    <h1>The Senate register</h1>
    <p class="lede measure">
      Every Senate committee report the President of the Senate records as still
      waiting for a government response. The Senate has required {reg.rule} since
      {" "}{reg.ruleSince}. A report leaves this register when a response is tabled —
      whatever that response says.
    </p>

    <StatTiles stats={stats} note={statsNote} />
  </section>

  <section class="wrap">
    <h2 id="source">Where this comes from, and what it leaves out</h2>
    <p class="note measure">
      This register publishes what the presiding officer records, and nothing else.
      Twice a year the President reports to the Senate on the status of every committee
      report that requires a government response. The most recent is
      {" "}<a href={sched.url}>the report as at {formatDate(sched.asAt)}</a>, tabled on
      {" "}{formatDate(sched.tabled)}. It lists {fmt(sched.listed)} reports and records a
      response received for {fmt(sched.answeredAtSchedule)} of them. The rest are here.
    </p>
    <p class="note measure">
      Since that date {fmt(sched.answeredSince)} more responses have been tabled, and those
      reports have been removed. The Senate also runs a live tracker of reports awaiting a
      response; it is carried here only for reports tabled after the President’s date, so it
      can add to the register but never overrule it.
      {sched.fromTracker === 0
        ? " On this build it adds nothing, and every row below is the President’s."
        : ` On this build it adds ${fmt(sched.fromTracker)} ${sched.fromTracker === 1 ? "report" : "reports"}, each marked in the source column.`}
    </p>
    <p class="note measure">
      <strong>What it does not have:</strong> reports tabled after
      {" "}{formatDate(sched.coversTo)}, which neither source yet lists; anything the
      President excludes from his report, which includes reports on bills whose
      recommendations can only be dealt with in debate, estimates and annual-report
      scrutiny, and the Senate’s domestic committees; and the House of Representatives,
      which has its own presiding officer, its own schedule and its own six-month rule.
    </p>
  </section>

  <section class="wrap">
    <h2 id="outstanding">Outstanding reports</h2>
    <p class="note measure">
      Ordered by how long each has waited. The status column is the President’s own:
      <em>being considered</em> is what he records as “Interim*”, and defines in his report
      as the government saying only that “the Government’s response is being considered”.
      <a href="/methods">How this is built</a>.
    </p>
    <p class="note measure">
      Report titles link to the report itself on the Parliament's website where the Tabled
      Documents index has it. That index begins in 2022, so reports tabled before then are
      listed here without a link rather than with a guessed one.
    </p>
    <RegisterControls target="senate-register" noun="reports" />
    <table class="register" id="senate-register">
      <thead>
        <tr>
          <th scope="col" class="num">Waiting</th>
          <th scope="col">Report</th>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Tabled</th>
          <th scope="col">Status</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr
            data-days={r.daysOutstanding}
            data-title={r.title}
            data-committee={r.body}
            data-search={`${r.title} ${r.body} ${statusOf(r)} ${formatDateShort(r.owedSince)} ${r.owedSince}`.toLowerCase()}
          >
            <td class="num nowrap">
              {fmt(r.daysOutstanding)} days
              <span class="human">{humanDuration(r.daysOutstanding)}</span>
            </td>
            <td>{r.url
              ? <a href={r.url} rel="external">{r.title}</a>
              : r.title}</td>
            <td class="cmte">{r.body}</td>
            <td class="num nowrap">{formatDateShort(r.owedSince)}</td>
            <td class="src">{statusOf(r)}</td>
            <td class="src">{r.source.startsWith("presidents") ? "President’s report" : "Senate tracker"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="by-committee">By committee</h2>
    <p class="note measure">
      Committees with reports still outstanding, most first.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Committee</th>
          <th scope="col" class="num">Outstanding</th>
          <th scope="col" class="num">Longest wait</th>
        </tr>
      </thead>
      <tbody>
        {byCommittee.map((c) => (
          <tr>
            <td>{c.body}</td>
            <td class="num">{fmt(c.count)}</td>
            <td class="num nowrap">{fmt(c.longest)} days</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="compliance">Whether the deadline is met</h2>
    <p class="note measure">
      The register above is what is owed now. This is the record over
      {" "}{comp.lastYear - comp.firstYear} years: every response tabled between{" "}
      {comp.firstYear} and {comp.lastYear} whose report date the Senate’s register records —
      {" "}{fmt(comp.assessable)} of them — measured against the three-month rule. The interval
      runs from the report’s last tabling, which is the reading most favourable to the
      government. <a href="/methods#limits">What this does and does not count</a>.
    </p>

    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Time taken to respond</th>
          <th scope="col" class="num">Responses</th>
          <th scope="col" class="num">Share</th>
        </tr>
      </thead>
      <tbody>
        {comp.buckets.map((b) => (
          <tr>
            <td>{b.label}</td>
            <td class="num">{fmt(b.count)}</td>
            <td class="num">{(b.share * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note measure">
      Median: {fmt(comp.medianDays)} days, or about {inMonths(comp.medianDays)}, against a
      rule of three.
    </p>
    {LAUNCHED && (
      <p class="note measure">
        This measures only whether a response arrived, not whether it answered anything.
        {" "}<a href="/senate/responses/">How the government answered →</a>
      </p>
    )}

    <h3 id="by-government">By government</h3>
    <p class="note measure">
      A late response can be attributed to the government that tabled it, or to the government
      in office when the report was tabled. The two readings disagree about who performs worst,
      and the disagreement is the point: the ordering is an artefact of the choice, while the
      range — never above single figures — is not. Both are shown so that neither can be quoted
      alone.
    </p>
    <table class="register narrow">
      <thead>
        <tr>
          <th scope="col">Government</th>
          <th scope="col" class="num">Responses tabled</th>
          <th scope="col" class="num">Met the rule</th>
          <th scope="col" class="num">Reports tabled</th>
          <th scope="col" class="num">Met the rule</th>
        </tr>
      </thead>
      <tbody>
        {comp.governments.map((g) => (
          <tr>
            <td>{g.name}</td>
            <td class="num">{fmt(g.byResponse.n)}</td>
            <td class="num">{(g.byResponse.rate * 100).toFixed(1)}%</td>
            <td class="num">{fmt(g.byReport.n)}</td>
            <td class="num">{(g.byReport.rate * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note measure">
      Columns two and three count responses by who tabled them; columns four and five count
      them by who was in office when the report was tabled. No government in
      {" "}{comp.lastYear - comp.firstYear} years reaches one response in ten inside the deadline,
      on either reading.
    </p>
  </section>

  <section class="wrap">
    <p class="note measure">
      The whole register is available as CSV in the
      <a href="https://github.com/toohardbasket-lab/toohardbasket">public repository</a>,
      licensed CC BY 4.0. If you believe a row is wrong, please write to
      <a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a> —
      corrections are made within 24 hours of being confirmed and listed in the
      {" "}<a href="/corrections/">corrections log</a>.
    </p>
  </section>
</Base>

<style>
  .intro { padding-bottom: 1.5rem; }
  h2 { margin-top: 2.5rem; }
  .note { font-size: 0.875rem; color: var(--ink-muted); }


  table.register td { padding-right: 1rem; }
  .cmte, .src { color: var(--ink-secondary); font-size: 0.8125rem; }
  .nowrap { white-space: nowrap; }
  .human { display: block; font-size: 0.75rem; color: var(--ink-muted);
           font-variant-numeric: normal; }
  table.narrow { max-width: 44rem; }
</style>
