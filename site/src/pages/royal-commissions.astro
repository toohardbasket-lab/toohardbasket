---
/**
 * The royal commissions index — draft.
 *
 * An index, not a register, and the distinction is the site's own. A register
 * counts reports awaiting an answer against a rule, and /methods/ admits one
 * only where an obligation, a claimant and a date can all be established. A
 * royal commission has none of the three: no statute requires a government to
 * answer one, no officer of the Parliament keeps a schedule of the answers, and
 * there is no date to be past. What is published here is the same shape as the
 * committee recommendations index — what was recommended, and what the
 * government said about it — over a second corpus, sharing that index's verdict
 * vocabulary and its test of what counts as a stated position. Elapsed time is
 * shown because it is arithmetic on two tabling dates; nothing is computed
 * against it.
 *
 * Every figure comes from the dataset at build time. Nothing on this page is
 * typed in.
 */
import Base from "../layouts/Base.astro";
import { ROYAL_COMMISSIONS_DRAFT } from "../lib/draft";
import StatTiles from "../components/StatTiles.astro";
import { fmt, formatDate, formatDateShort, humanDuration } from "../lib/data";
import { commissions, rcRecommendations, rcFigures, rcLabels } from "../lib/royalCommissions";

const all = commissions();
// One row per report that carries recommendations, not one per commission: a
// commission can make recommendations twice and be answered twice.
const pairs = all.flatMap((c) => c.reports.map((r) => ({
  ...r, commission: c.name, only: c.reports.length === 1,
})));
const rows = rcRecommendations();
const f = rcFigures();
const labels = rcLabels();

const stats = [
  { label: "Recommendations", value: fmt(f.recommendations) },
  { label: "Commissions", value: fmt(f.commissions) },
  { label: "With a stated position", value: fmt(f.position) },
  { label: "Answered without one", value: fmt(f.noted) },
  { label: "Named, not answered", value: fmt(f.namedNotAnswered) },
];

/* The bar. Not the committee register's six: there is no form letter here, and
   there is a segment that register has no need of. A government that names a
   recommendation and says it is not the one answering it has not been silent
   about it, and is not shown as though it were. A segment nothing falls into
   is left off rather than drawn at nothing, which is what "not addressed" is
   today: it is kept because a response that never mentions a recommendation is
   a thing that can happen, not because one has. */
const segments = [
  { key: "accepted", label: "Accepted", n: f.accepted },
  { key: "part", label: "In part or in principle", n: f.inPartOrInPrinciple },
  { key: "not", label: "Not accepted", n: f.notAccepted },
  { key: "noted", label: "Answered, no position stated", n: f.noted },
  { key: "passed", label: "Named, not answered", n: f.namedNotAnswered },
  { key: "silent", label: "Not addressed by the response", n: f.notAddressed },
].filter((s) => s.n > 0).map((s) => ({ ...s, share: s.n / (f.recommendations || 1) }));
const pct = (v: number) => `${Math.round(v * 100)}%`;

/* How a row reads in the "what the government said" column. */
function saidOf(r: (typeof rows)[number]): string {
  if (r.state === "not addressed") return "The response does not address it";
  // Named somewhere other than under an answer to it — in a list of what the
  // government is not answering. The response's own sentence about that list
  // is the row's quotation, so the reason given is the government's, not ours.
  if (r.state === "named, not answered") return "The response names it and does not answer it";
  if (r.governmentLabel) return r.governmentLabel;
  // A response can name a recommendation and answer nothing about it, and then
  // the row's own note is what happened. "No words could be read" would say the
  // reading failed, when nothing failed and there was nothing to read.
  if (!r.governmentWords && r.positionNote) return r.positionNote;
  return "No words could be read";
}
const SHOWN = 25;
---

<Base
  noindex={ROYAL_COMMISSIONS_DRAFT}
  title="Royal commissions — draft"
  description="Draft: every recommendation the Robodebt and Disability royal commissions made, with the government's own words about each one, and no deadline claim of any kind."
>
  <p class="draft wrap">
    <strong>Draft.</strong> This page is not published. It is here to be looked at and
    argued with; the figures on it are built from the dataset like every other page, but
    nothing about it is settled.
    {" "}<a href="/methods/royal-commissions/">How it is built</a>.
  </p>

  <section class="wrap intro">
    <p class="eyebrow">
      Royal commissions · {fmt(f.recommendations)} recommendations from {fmt(f.commissions)} commissions
    </p>
    <h1>What royal commissions asked for</h1>
    <p class="lede measure">
      {fmt(f.commissions)} commissions, {fmt(f.recommendations)} recommendations, and what the Australian
      Government said about each one in its own words. {fmt(f.position)} carry a stated
      position. {fmt(f.noted)} were answered without one. {fmt(f.namedNotAnswered)} the response
      names and does not answer.
    </p>
    <StatTiles stats={stats} note="Counted over every recommendation every commission here made." />
  </section>

  <section class="wrap">
    <h2 id="no-deadline">There is no deadline here</h2>
    <p class="measure">
      The registers on this site measure a wait against a rule: a Senate committee report is
      owed a response in three months, a House report in six. No such rule exists for a royal
      commission. A government answers one when it decides to, so nothing on this page is
      overdue, nothing is late, and no clock runs against anybody. That is why this is an
      index rather than a register: it sets out what was recommended and what the government
      said about each recommendation, and claims nothing about time.
      {" "}<a href="/methods/royal-commissions/">How it is built</a>. What the table below
      shows is elapsed time — the days between the report being tabled and the
      response being tabled — because that is arithmetic rather than judgement.
    </p>

    <table class="register narrow">
      <caption class="sr-only">Each commission, its report, and the government's response</caption>
      <thead>
        <tr>
          <th scope="col">Commission</th>
          <th scope="col" class="num">Report tabled</th>
          <th scope="col" class="num">Response tabled</th>
          <th scope="col" class="num">Time taken</th>
          <th scope="col" class="num">Recommendations</th>
        </tr>
      </thead>
      <tbody>
        {pairs.map((c) => (
          <tr>
            <td>
              {c.commission}
              {!c.only && c.label && <span class="which"> · {c.label.toLowerCase()}</span>}
            </td>
            <td class="num nowrap" data-label="Report tabled">
              {c.url
                ? <a href={c.url} rel="external">{formatDateShort(c.tabled)}</a>
                : formatDateShort(c.tabled)}
            </td>
            <td class="num nowrap" data-label="Response tabled">
              {c.responseUrl
                ? <a href={c.responseUrl} rel="external">{formatDateShort(c.responseTabled)}</a>
                : "None tabled"}
            </td>
            <td class="num nowrap" data-label="Time taken">
              {c.daysToRespond === null
                ? `${fmt(c.daysSinceReport)} days and counting`
                : `${fmt(c.daysToRespond)} days`}
            </td>
            <td class="num nowrap" data-label="Recommendations">
              {fmt(c.found)}{c.stated && String(c.found) !== c.stated && (
                <span class="disagree"> · the report says {c.stated}</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap">
    <h2 id="split">What the government said</h2>
    <figure class="positions">
      <figcaption class="sr-only" id="rc-positions-title">
        What the Australian Government said about each of the {fmt(f.recommendations)} recommendations
      </figcaption>
      <div class="bar" role="img" aria-labelledby="rc-positions-title">
        {segments.map((s) => (
          <span class={`seg ${s.key}`} style={`width: ${(s.share * 100).toFixed(2)}%`}
                title={`${s.label}: ${fmt(s.n)} of ${fmt(f.recommendations)} (${pct(s.share)})`}>
            {s.share >= 0.09 && <b>{pct(s.share)}</b>}
          </span>
        ))}
      </div>
      <ul class="legend">
        {segments.map((s) => (
          <li><i class={`sw ${s.key}`}></i>{s.label}: {fmt(s.n)} ({pct(s.share)})</li>
        ))}
      </ul>
    </figure>
    <p class="note measure">
      The vocabulary is the one the rest of the site uses, and it is not extended for these
      documents. A government's own word is sorted three ways — accepted, in part or in
      principle, not accepted — and anything else states no position and is shown as the
      government wrote it.
      {f.notAccepted === 0
        ? " No response in this index refuses a recommendation outright."
        : ` ${fmt(f.notAccepted)} ${f.notAccepted === 1 ? "recommendation was" : "recommendations were"} refused outright.`}
    </p>
  </section>

  <section class="wrap">
    <h2 id="index">The index</h2>
    <p class="measure">
      Every recommendation, in the commission's own words, with the government's own words
      about it. Both are quoted from tabled documents, and both are linked.
    </p>
    <div class="controls" data-rc-controls>
      <label for="rc-q" class="sr-only">Search the recommendations</label>
      <input id="rc-q" type="search" data-rc-q autocomplete="off" spellcheck="false"
             placeholder="Search: health, legal, data…" enterkeyhint="search" />
      <span class="chips">
        <button type="button" class="chip" data-rc-filter="" aria-pressed="true">All</button>
        {all.map((c) => (
          <button type="button" class="chip" data-rc-filter={c.id} data-name={c.name}
                  aria-pressed="false">
            {c.short}
          </button>
        ))}
      </span>
      {/*
        One group, and the boxes in it widen the result rather than narrowing
        it. "Named but not answered" and "answered without a stated position"
        are two different ways of getting no answer, and a reader who wants
        both means the 92 rows that are one or the other — not the none that
        are both, which is what tick boxes that narrow would show.
      */}
      <fieldset class="filters">
        <legend>Show only</legend>
        <label>
          <input type="checkbox" data-rc-only="named, not answered" />
          Named by the response, not answered ({fmt(f.namedNotAnswered)})
        </label>
        <label>
          <input type="checkbox" data-rc-only="noted" />
          Answered without a stated position ({fmt(f.noted)})
        </label>
        <label>
          <input type="checkbox" data-rc-only="not accepted" />
          Not accepted ({fmt(f.notAccepted)})
        </label>
      </fieldset>
      <p class="status" data-rc-status role="status" aria-live="polite"></p>
    </div>

    <table class="register stacks" id="rc-register">
      <caption class="sr-only">Royal commission recommendations and the government's position on each</caption>
      {/*
        The widths are set here, on the columns, rather than in the stylesheet.
        Base.astro lays a stacks table out fixed above 60rem and sets its first
        column to 9rem, because on the two committee registers that column
        holds a number of days. Here it holds the recommendation, and 9rem wrapped
        it to about twenty characters a line. A col carries the width past that
        rule without either page having to know about the other.
      */}
      <colgroup>
        <col style="width: 55%" />
        <col style="width: 45%" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">Recommendation</th>
          <th scope="col">What the government said</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr data-commission={r.commissionId} data-state={r.state} data-verdict={r.verdict}>
            <td class="c-rec">
              <p class="rec-head">
                <span class="rec-no">{r.commissionShort} {r.label}</span>
                {r.reportLabel && <span class="which"> · {r.reportLabel}</span>}
                {r.reportUrl && <> · <a href={r.reportUrl} rel="external">the report</a></>}
              </p>
              {r.heading && <p class="rec-title">{r.heading}</p>}
              {r.text
                ? <p class="rec-text">{r.text}</p>
                : <p class="rec-text missing">The report's own words could not be read: {r.textNote}.</p>}
            </td>
            <td class="c-said" data-label="What the government said">
              <p class={`said ${r.verdict ? "stated" : "unstated"}`}>{saidOf(r)}</p>
              {r.verdict && <p class="sorted">Sorted as: {r.verdict}</p>}
              {r.otherGovernments && (
                <p class="others">The states and territories: {r.otherGovernments}</p>
              )}
              {r.governmentWords && (
                <p class="words">
                  {r.governmentWords}
                  {r.governmentWordsMore && <span class="more"> … the answer continues</span>}
                </p>
              )}
              {r.responseUrl && (
                <p class="src">
                  <a href={r.responseUrl} rel="external">the response</a>
                  {r.responseTabled && <> · tabled {formatDateShort(r.responseTabled)}</>}
                </p>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="more measure" data-rc-more hidden></p>
  </section>

  <section class="wrap measure">
    <h2 id="record">What the record shows</h2>

    <h3>The counts, against the reports' own</h3>
    <p>
      A report usually says how many recommendations it makes, and that sentence is checked
      against what was extracted rather than trusted or ignored.
      {pairs.map((c) => (
        <>
          {" "}The {c.commission}{!c.only && c.label ? ` ${c.label.toLowerCase()}` : ""}
          {" "}{c.stated && String(c.found) === c.stated
            ? <>says it makes {c.stated} and {c.stated} is what is there.</>
            : <>says it makes {c.stated || "no stated number"}, and {fmt(c.found)} are printed
              under their own numbers; neither figure is adopted here.
              {c.unnumbered > 0 && c.found + c.unnumbered === Number(c.stated) && (
                <>{" "}The difference is in the report's own list, which heads
                {" "}{c.unnumbered === 1 ? "one more item" : `${fmt(c.unnumbered)} more items`} the
                way it heads a recommendation and gives
                {" "}{c.unnumbered === 1 ? "it" : "them"} no number: “{c.unnumberedWords}”.
                {" "}Every row here is keyed by the number the report prints, so that
                {" "}{c.unnumbered === 1 ? "one has" : "those have"} none.</>
              )}</>}
        </>
      ))}
    </p>

    {f.textUnreadable > 0 && (
      <>
        <h3>Where the words could not be read</h3>
        <p>
          {fmt(f.textUnreadable)} of the {fmt(f.recommendations)} carry no text. In each case the
          report names nothing between the recommendation and whatever follows it, so where it
          ends cannot be read mechanically. The row says so and links to the report, rather than
          guessing at a boundary the report did not draw. Note that the government's position on
          it is known even where its words are not.
        </p>
      </>
    )}

    <h3>A recommendation that is not public</h3>
    <p>
      The Royal Commission on Antisemitism and Social Cohesion put five of the fourteen
      recommendations in its interim report into a confidential report. Where the recommendation
      would be, the public report prints its number and one sentence saying so, and the
      government's response prints the same. Those five are here, with their numbers and that
      sentence, because a gap in the numbering with no explanation would tell a reader less than
      the truth does.
    </p>
    <p>
      Their rows say the response names the recommendation and states no position on it. That is
      not the same as the response not addressing it, which on this index means the response does
      not mention the recommendation at all — and of these five it plainly does. No words are
      shown as the government's: under every other heading in that response the recommendation is
      reprinted before the answer, so the one sentence under these could be either, and this index
      does not decide that by guessing.
    </p>

    <h3>The government's own words, and how they were sorted</h3>
    <table class="register narrow">
      <caption class="sr-only">Each label a government used, and how the site sorts it</caption>
      <thead>
        <tr>
          <th scope="col">What the government wrote</th>
          <th scope="col">Sorted as</th>
          <th scope="col" class="num">Recommendations</th>
        </tr>
      </thead>
      <tbody>
        {labels.map((l) => (
          <tr>
            <td>{l.label}</td>
            <td data-label="Sorted as">{l.verdict || "no position stated"}</td>
            <td class="num" data-label="Recommendations">{fmt(l.n)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      "Subject to further consideration" and "Note" use no verdict word, so they state no
      position. They are shown as written and counted as neither an acceptance nor a refusal.
    </p>

    <h3>Where a recommendation was for more than one government</h3>
    <p>
      {fmt(f.withTheStates)} of these recommendations are answered by the Commonwealth together
      with the states and territories. Where the response gives them separate verdicts, only the
      Commonwealth's is counted here, decided by which government the response names on the
      line; the states' answer is recorded beside it because the document says it. Where the
      Commonwealth is not named on any line, this index shows no Commonwealth position, even
      if every state accepted.
    </p>

    <h3>What is not here</h3>
    <p>
      {fmt(f.commissions)} commissions, all Commonwealth. State royal commissions are not in
      scope. Where a commission has reported more than once and been answered more than once,
      each report and its own response is a pair of its own, because the numbering starts again
      at one in each of them.
    </p>
    <p>
      This index is rebuilt with the rest of the dataset every Tuesday, and every step of it
      refuses rather than write something it cannot stand behind — the sweep when the
      register's own record count disagrees, the extraction when a report it is told to read
      has no text, the check when less than nine tenths of the index can be found in the
      documents it names. While the index is a draft those refusals raise an alarm rather than
      stop the run, because no published page reads any of these files and a draft that cannot
      be built is not a reason to leave the registers a week stale. When it is published they
      will stop the run, like every other gate on this site.
    </p>
  </section>

  <section class="wrap measure">
    <h2 id="source">Where this comes from</h2>
    <p>
      Everything above is built from four files in the published dataset, each produced by a
      script in the same repository:
      {" "}<a href="https://github.com/toohardbasket-lab/toohardbasket/blob/main/scraper/data/rc_documents.csv">rc_documents.csv</a>,
      {" "}<a href="https://github.com/toohardbasket-lab/toohardbasket/blob/main/scraper/data/rc_recommendations.csv">rc_recommendations.csv</a>,
      {" "}<a href="https://github.com/toohardbasket-lab/toohardbasket/blob/main/scraper/data/rc_positions.csv">rc_positions.csv</a>
      {" "}and the two count files beside them. The reports and responses are the copies tabled
      in Parliament, not the copies on department websites, because the tabled copies come back
      the same every time they are fetched and the departmental ones do not. Why that matters is
      set out in
      {" "}<a href="https://github.com/toohardbasket-lab/toohardbasket/blob/main/docs/royal-commissions/source-test-2026-09.md">the source test</a>.
    </p>
  </section>
</Base>

<style>
  .draft {
    margin: 1rem auto 0; padding: 0.7rem 1rem;
    border-left: 3px solid var(--ink);
    background: var(--rule); font-family: var(--sans); font-size: 0.9375rem;
  }
  .disagree { color: var(--ink-secondary); font-family: var(--sans); font-size: 0.8125rem; }

  .positions { margin: 1rem 0 1.25rem; }
  .bar { display: flex; width: 100%; height: 1.9rem; }
  .seg {
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    font-family: var(--sans); font-size: 0.8125rem; font-weight: 600; color: var(--surface);
  }
  .seg.accepted { background: var(--series-1); }
  .seg.part { background: repeating-linear-gradient(45deg, var(--series-1) 0 3px, var(--surface) 3px 6px); color: var(--ink); }
  .seg.not { background: var(--surface); box-shadow: inset 0 0 0 2px var(--series-1); color: var(--ink); }
  .seg.noted { background: var(--rule-strong); color: var(--ink); }
  .seg.passed { background: var(--rule); color: var(--ink); }
  .seg.silent { background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule-strong); color: var(--ink); }
  .seg.part b { background: var(--surface); padding: 0 0.3rem; }
  .legend {
    list-style: none; padding: 0; margin: 0.75rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem;
    font-family: var(--sans); font-size: 0.875rem; color: var(--ink-secondary);
  }
  .legend li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .sw { display: inline-block; width: 0.7rem; height: 0.7rem; flex: none; }
  .sw.accepted { background: var(--series-1); }
  .sw.part { background: repeating-linear-gradient(45deg, var(--series-1) 0 2px, var(--surface) 2px 4px); }
  .sw.not { background: var(--surface); box-shadow: inset 0 0 0 2px var(--series-1); }
  .sw.noted { background: var(--rule-strong); }
  .sw.passed { background: var(--rule); }
  .sw.silent { background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule-strong); }

  .controls { margin: 1rem 0; font-family: var(--sans); }
  .controls input[type="search"] {
    width: 100%; max-width: 28rem; padding: 0.55rem 0.7rem;
    border: 1px solid var(--rule-strong); background: var(--surface); color: var(--ink);
    font: inherit; font-size: 1rem;
  }
  .chips { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
  .chip {
    font: inherit; font-size: 0.875rem; padding: 0.25rem 0.7rem; cursor: pointer;
    border: 1px solid var(--rule-strong); background: var(--surface); color: var(--ink-secondary);
  }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .controls .status { margin: 0.6rem 0 0; font-size: 0.875rem; color: var(--ink-secondary); }
  .filters {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0; padding: 0; border: 0; font-size: 0.875rem;
    color: var(--ink-secondary);
  }
  .filters legend {
    padding: 0; margin-right: 0.25rem; font-size: 0.8125rem;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-secondary);
  }
  .filters label { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; }

  .rec-head { margin: 0 0 0.35rem; font-family: var(--sans); font-size: 0.8125rem; color: var(--ink-secondary); }
  .rec-no { font-weight: 600; color: var(--ink); }
  /* The report's own heading, set the way the report sets it: above the
     recommendation and in a heavier weight. It is the commission's words, not
     a label of ours, so it is not styled as furniture. */
  .rec-title { margin: 0 0 0.3rem; font-weight: 600; }
  .rec-text { margin: 0; }
  .rec-text.missing { color: var(--ink-secondary); font-style: italic; }
  .c-rec, .c-said { vertical-align: top; }
  .said { margin: 0; font-family: var(--sans); font-weight: 600; }
  .said.unstated { font-weight: 400; color: var(--ink-secondary); }
  .sorted, .others, .src { margin: 0.3rem 0 0; font-family: var(--sans); font-size: 0.8125rem; color: var(--ink-secondary); }
  .words { margin: 0.45rem 0 0; font-size: 0.9375rem; color: var(--ink-secondary); }
  /* Where the government's answer runs on past what is printed here. Said
     rather than shown as a bare ellipsis, which a reader can read as the
     document trailing off rather than as this page stopping. */
  .words .more { color: var(--ink-secondary); font-style: italic; }
  /* Which of a commission's reports a row is about, where it has more than one. */
  .which { color: var(--ink-secondary); }
  /* Long prose in a wide column is as hard to read as short prose in a narrow
     one: the eye loses the line coming back. The column is wide enough for the
     government's answer beside it; the recommendation itself keeps to a
     reading measure inside it, as prose does everywhere else on the site. And
     the recommendation is a sentence rather than a URL, so it wraps between
     words: the stacks rule breaks anywhere, which is right for a long report
     title and wrong here. */
  #rc-register td.c-rec { overflow-wrap: normal; }
  #rc-register .rec-text, #rc-register .rec-title { max-width: 62ch; }
  #rc-register .c-said > * { max-width: 54ch; }
</style>

<script>
  /* Filter and search over rows already in the page, and show the first
     twenty-five until a reader asks for more. No index is fetched: the whole
     index is in the HTML, so this works from a saved copy and degrades to
     every row with JavaScript off.

     What a row is searched on is read out of the row itself, once, at load.
     Until 10 September each row also carried a `data-search` attribute holding
     a lower-cased copy of its own words — 644 KB of the page, 38 per cent of
     it, saying a second time what the row already said. The row's own text is
     the same words, so the copy is gone and the page is 1,055 KB instead of
     1,703, and 159 KB over the wire instead of 199.

     The parts are named rather than taking the whole row, because a row also
     contains "the report", "the response" and a tabling date, and searching
     "report" should not match all 427. The one thing a row does not print is
     its commission's full name — it prints the short one — so that comes off
     the filter chip, which carries it for this reason. */
  const table = document.getElementById("rc-register") as HTMLTableElement | null;
  const controls = document.querySelector<HTMLElement>("[data-rc-controls]");
  const box = document.querySelector<HTMLInputElement>("[data-rc-q]");
  const status = document.querySelector<HTMLElement>("[data-rc-status]");
  const more = document.querySelector<HTMLElement>("[data-rc-more]");
  if (table && controls && box && status && more) {
    const rows = Array.from(table.tBodies[0].rows);
    const LIMIT = 25;

    /* The parts of a row a reader is searching: its number, which report it
       came from, its heading, the commission's words, the government's label,
       the other governments, and the government's words. The sorted verdict
       comes off the row's own data attribute rather than out of the printed
       line, which begins "Sorted as:" and would make "sorted" match 309 rows
       and mean nothing. */
    const SEARCHABLE = ".rec-no, .which, .rec-title, .rec-text, .said, .others, .words";
    const names = new Map(
      Array.from(controls.querySelectorAll<HTMLElement>("[data-rc-filter]"))
        .filter((c) => c.dataset.rcFilter)
        .map((c) => [c.dataset.rcFilter as string, c.dataset.name ?? ""]),
    );
    const haystack = new WeakMap<HTMLTableRowElement, string>();
    for (const r of rows) {
      const own = Array.from(r.querySelectorAll<HTMLElement>(SEARCHABLE))
        .map((el) => el.textContent ?? "").join(" ");
      haystack.set(r, `${own} ${r.dataset.verdict ?? ""} ${names.get(r.dataset.commission ?? "") ?? ""}`
        .toLowerCase().replace(/\s+/g, " "));
    }
    let commission = "";
    let showAll = false;
    const only = Array.from(
      controls.querySelectorAll<HTMLInputElement>("[data-rc-only]"),
    );

    const apply = () => {
      const q = box.value.trim().toLowerCase();
      const terms = q ? q.split(/\s+/) : [];
      /* The ticked boxes are a union; the commission and the words narrow it. */
      const wanted = only.filter((b) => b.checked).map((b) => b.dataset.rcOnly);
      const matching = rows.filter((r) => {
        if (commission && r.dataset.commission !== commission) return false;
        if (wanted.length
            && !wanted.includes(r.dataset.state ?? "")
            && !wanted.includes(r.dataset.verdict ?? "")) return false;
        const hay = haystack.get(r) ?? "";
        return terms.every((t) => hay.includes(t));
      });
      const shown = showAll ? matching : matching.slice(0, LIMIT);
      const show = new Set(shown);
      for (const r of rows) r.hidden = !show.has(r);
      status.textContent = matching.length === rows.length
        ? `Showing ${shown.length} of ${rows.length} recommendations`
        : `${matching.length} of ${rows.length} recommendations match`
          + (matching.length && matching.length > shown.length ? `; showing ${shown.length}` : "");
      if (matching.length > shown.length) {
        more.hidden = false;
        more.innerHTML = "";
        const b = document.createElement("button");
        b.type = "button";
        b.className = "chip";
        b.textContent = `Show all ${matching.length}`;
        b.addEventListener("click", () => { showAll = true; apply(); });
        more.appendChild(b);
      } else {
        more.hidden = true;
      }
    };

    box.addEventListener("input", () => { showAll = false; apply(); });
    for (const b of only) {
      b.addEventListener("change", () => { showAll = false; apply(); });
    }
    for (const chip of controls.querySelectorAll<HTMLButtonElement>("[data-rc-filter]")) {
      chip.addEventListener("click", () => {
        commission = chip.dataset.rcFilter ?? "";
        showAll = false;
        for (const c of controls.querySelectorAll<HTMLButtonElement>("[data-rc-filter]")) {
          c.setAttribute("aria-pressed", String(c === chip));
        }
        apply();
      });
    }
    apply();
  }
</script>
