---
import Base from "../layouts/Base.astro";
import { ABOUT, unfilled, inWords } from "../lib/about";
import { REGISTERS, plannedRegisters } from "../lib/registers";

// Unfilled facts render an unmissable draft banner rather than quietly shipping
// as "«founder's full name»". src/lib/about.ts also exports validateAbout(),
// which throws instead — swap it in here once the four values are filled, so a
// later edit that blanks one cannot reach a live page.
const missing = unfilled();

const commitments = [
  "No political party affiliation, membership or endorsement.",
  "No government funding. If that ever changes, it will be disclosed here before the money is accepted.",
  "No paid advocacy, consulting or lobbying on any matter this site covers.",
  "No commercial products, sponsorships or advertising.",
  "Every dataset published in full under a named open licence.",
  "Every method published, including what it cannot see.",
  "A corrections policy with a named contact and a stated turnaround.",
];

/* Counts under ten are written out. A page that says "1 more is planned"
   reads as a variable someone forgot to phrase. */
const NUMBERS = ["no", "one", "two", "three", "four", "five", "six", "seven",
                 "eight", "nine"];
const words = (n: number) => NUMBERS[n] ?? String(n);
const cap = (w: string) => w.charAt(0).toUpperCase() + w.slice(1);
---

<Base
  title="About"
  description="Who publishes The Too Hard Basket, who runs it, how it is funded, and every connection that could bear on its independence."
>
  <section class="wrap intro">
    <p class="eyebrow">About</p>
    <h1>Who publishes this</h1>
    <p class="lede measure">
      This site keeps a record of what governments owe parliaments: which committee
      reports have been answered, which have not, and how long each has taken. This page
      says who keeps that record, how it is paid for, and every connection that could bear
      on it, including the one that gave the project its name.
    </p>
  </section>

  {missing.length > 0 && (
    <section class="wrap">
      <p class="draft measure">
        <strong>Draft — not for publication.</strong> This page still contains unfilled
        placeholders: {missing.join(", ")}. Fill them in <code>src/lib/about.ts</code>.
      </p>
    </section>
  )}

  <section class="wrap measure">
    <h2>The publisher</h2>
    <p>
      The Too Hard Basket is published by
      {" "}<strong><a href={ABOUT.site}>{ABOUT.entityName}</a></strong> (APIA),
      an incorporated association registered in {ABOUT.state} under the {ABOUT.act},
      incorporation number {ABOUT.incorporationNumber}, ABN {ABOUT.abn}.
      {" "}{ABOUT.acncRegistered ? "APIA is registered with the ACNC." : "APIA is not registered with the ACNC"}
      {ABOUT.dgrEndorsed
        ? " and is endorsed as a deductible gift recipient."
        : " and is not endorsed as a deductible gift recipient, so donations to it are not tax deductible."}
    </p>
    <p>
      APIA exists to publish and maintain independent datasets about Australian government
      performance. A register that stops being updated is worse than none, because people
      go on citing it, so the dataset sits under an incorporated body rather than a personal
      account.
    </p>
    <p>
      APIA is governed by a committee of {inWords(ABOUT.committeeSize)}, of which
      {" "}{ABOUT.founderName} is President.
      {ABOUT.committeeNames.length > 0
        ? ` The committee is ${ABOUT.committeeNames.join(", ")}.`
        : " The membership is on the public register maintained by Consumer Protection (WA)."}
      {" "}{ABOUT.fundingStatement} If that changes, this page will say so and name the source.
      {" "}<a href={ABOUT.governancePage}>APIA's governance page</a> carries its legal status,
      the rules it operates under and the same funding statement.
    </p>
    {ABOUT.soloOperated && (
      <p>
        <strong>In practice this is one person's work.</strong> The other two committee
        members provide the governance an incorporated association requires; they do not
        direct the project or review it day to day. Nothing on this site depends on trusting
        the organisation: every figure is computed by published code from published data,
        every row links to the official document it came from, and the
        {" "}<a href="/methods/">methods page</a> sets out what the method cannot see.
      </p>
    )}
  </section>

  <section class="wrap measure">
    <h2>Disclosure</h2>
    <p>
      <strong>{ABOUT.founderName}, {ABOUT.founderRole}, volunteers in an unpaid capacity in
      the electorate office of Kate Chaney MP, the independent member for Curtin.</strong>
      {" "}He is not employed by her, not paid by her, and not directed by her.
      APIA receives no funding, direction or editorial input from any parliamentarian, party
      or candidate, and this site was not requested by any of them.
    </p>
    <p>
      The idea for this register, and the phrase “too hard basket”, came from work done in
      that office in March 2026, when {ABOUT.founderName.split(" ")[0]} compiled a list of
      House committee reports the government had not answered, for a campaign page under
      that name. That page is no longer published and nothing from it is used here: this
      site was rebuilt from the presiding officers’ own records, covers both chambers, names
      no member and has no per-member columns. <strong>No one in her office saw this site or
      was told of it before publication</strong>, and she has been given nothing that other
      members of the relevant committees were not.
    </p>
    <p>
      Several of the reports on that March list were answered afterwards. The list existed
      only because one member compiled it, it covered one chamber, and it stopped being
      maintained once the moment passed. This site keeps that list permanently, for every
      chamber.
    </p>
    {/*
      Alan: your own words go here, in the first person — why you built this
      and what you want it to do. A paragraph or two is enough. Leave this
      comment in place until they are written; it renders nothing.
    */}
  </section>

  <section class="wrap measure">
    <h2>Independence</h2>
    <p>
      These are the specific commitments, each of which can be checked:
    </p>
    <ul>
      {commitments.map((c) => <li>{c}</li>)}
    </ul>
    <p>
      The site costs very little to run: a domain, a mailbox and a static host.
    </p>
  </section>

  <section class="wrap measure">
    <h2>What this site does not do</h2>
    <p>
      It does not say whether a committee's recommendation was a good one, or whether the
      government was right to accept or reject it. It records only what the official record
      shows: that a report was tabled, that a response was or was not tabled, and when.
    </p>
    <p>
      It does not attribute motive. Where a response is absent, this site says no response is
      recorded, not that one was refused, suppressed or avoided. Where a judgment is finely
      balanced, it is resolved in the government's favour, so that every figure here is a floor.
    </p>
    <p>
      It is not partisan. The {" "}<a href="/senate/#by-government">record by government</a>
      {" "}shows four governments of both persuasions inside the same narrow band, under both
      of the two defensible ways of attributing a late response.
    </p>
  </section>

  <section class="wrap measure">
    <h2>Corrections</h2>
    <p>
      If something here is wrong, write to
      {" "}<a href="mailto:corrections@toohardbasket.org.au">corrections@toohardbasket.org.au</a>{" "}
      with the row and the source. Corrections are made within 24 hours of being confirmed and
      listed in the {" "}<a href="/corrections/">corrections log</a>, so the record of what
      this site said, and when it changed, stays visible.
    </p>
    <p>
      Anything else: <a href="mailto:contact@toohardbasket.org.au">contact@toohardbasket.org.au</a>.
      The dataset and the code that produces every figure are in the
      {" "}<a href="https://github.com/toohardbasket-lab/toohardbasket">public repository</a>:
      data under CC BY 4.0, code under the MIT licence.
      {" "}<a href="/methods/">How the register is built</a>.
    </p>
  </section>

  <section class="wrap measure">
    <h2>What comes next</h2>
    <p>
      The Senate register came first and the House of Representatives register second.
      {" "}{cap(words(plannedRegisters().length))} more {plannedRegisters().length === 1 ? "is" : "are"} planned:
      {" "}{plannedRegisters().map((r) => r.name).join("; ")}.
      Each is published as its own register with its own rule, because the obligation
      differs: the Senate asks for three months and the House for six, and a single combined
      number would mean nothing.
    </p>
    <p class="note">
      {cap(words(REGISTERS.filter((r) => r.status === "live").length))} registers are live and
      {" "}{words(plannedRegisters().length)} more {plannedRegisters().length === 1 ? "is" : "are"} planned.
    </p>
  </section>
</Base>

<style>
  .intro { padding-bottom: 1rem; }
  h2 { margin-top: 2.75rem; }
  .note { font-size: 0.875rem; color: var(--ink-secondary); }
  ul { padding-left: 1.1rem; margin: 0 0 1rem; }
  li { margin-bottom: 0.45rem; }
  code { font-size: 0.875em; }
  .draft {
    border: 1px solid var(--rule-strong); border-left: 3px solid var(--series-1);
    padding: 0.85rem 1rem; font-size: 0.9375rem; background: var(--surface-sunken);
  }
</style>
