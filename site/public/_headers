# Cloudflare Pages reads this file at deploy time and sends the headers below.
#
# The site is static, self-hosted and fetches nothing from anyone else, so the
# policy can say so: scripts, styles, fonts and the search index come from this
# origin only. The inline scripts (the clock, the search, the table controls)
# are Astro's own, and they are what 'unsafe-inline' is for here; a script
# from any other host is refused.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Hashed assets and the fonts never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
